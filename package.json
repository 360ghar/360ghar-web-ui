{
  "name": "360ghar-web-ui-2",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/sync-hi-routes.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-hi-routes.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "api:sync": "cp \"${BACKEND_DIR:-../360ghar-backend}/docs/openapi.json\" openapi/openapi.json",
    "api:types": "openapi-typescript openapi/openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts",
    "check:api": "cp src/lib/api/schema.d.ts \"${TMPDIR:-/tmp}/schema.d.ts.bak\" && pnpm api:types && diff -q src/lib/api/schema.d.ts \"${TMPDIR:-/tmp}/schema.d.ts.bak\"",
    "typecheck": "node scripts/sync-hi-routes.mjs && astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ai:discovery": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/write-ai-discovery.mjs",
    "seo:schemas": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/validate-structured-data.mjs",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "seo:gsc": "node scripts/gsc-audit.mjs",
    "seo:og-image": "node scripts/generate-og-image.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "data:ingest": "node scripts/data/ingest-entities.mjs",
    "data:build": "node scripts/data/build-localities.mjs",
    "data:price-context": "node scripts/data/build-price-context.mjs",
    "data:locality-redirects": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/data/build-locality-redirects.mjs",
    "check:pseo": "node scripts/data/pseo-quality-check.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.6",
    "@astrojs/react": "^7.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "astro": "^7.3.5",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.434.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3",
    "ultrahtml": "1.7.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/google.maps": "^3.66.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "sharp": "0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
