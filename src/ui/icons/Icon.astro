---
import { brands, icons, type BrandName, type IconName } from './paths';

type Props = {
  name: IconName | `brand:${BrandName}`;
  size?: number;
  /** Accessible name. Without it the icon is decorative. */
  label?: string;
  class?: string;
  /** Draw from the page's IconSprite (`<use href="#i-name">`) instead of an inline path. Not for brand marks. */
  sprite?: boolean;
};

const { name, size = 20, label, class: className, sprite = false } = Astro.props;
const isBrand = name.startsWith('brand:');
const d = isBrand ? brands[name.slice(6) as BrandName] : icons[name as IconName];
const useSprite = sprite && !isBrand;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class:list={['icon', className]}
  fill="currentColor"
  fill-rule="evenodd"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {useSprite ? <use href={`#i-${name}`} /> : <path d={d} />}
</svg>

<style is:global>
  /* Global, not scoped: a scoped style would add a data-astro-cid attribute to every icon on the site. */
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
