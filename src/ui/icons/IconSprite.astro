---
/**
 * One hidden SVG sprite with a <symbol> per icon. Render it once, then draw
 * the icons with `<Icon name="..." sprite />`: each use is a short <use> tag
 * instead of a full path, so an icon that shows many times on a page (the
 * header menus and the phone menu) is sent once.
 *
 *   <IconSprite names={['home', 'key']} />  ...  <Icon name="home" sprite />
 */
import { icons, type IconName } from './paths';

type Props = { names: IconName[] };
const names = [...new Set(Astro.props.names)];
---

<svg class="icon-sprite" width="0" height="0" aria-hidden="true" focusable="false">
  {
    names.map((n) => (
      <symbol id={`i-${n}`} viewBox="0 0 24 24">
        <path fill-rule="evenodd" d={icons[n]} />
      </symbol>
    ))
  }
</svg>

<style is:global>
  /* Global, not scoped: a scoped style would add a data-astro-cid attribute to every icon on the site. */
  .icon-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
