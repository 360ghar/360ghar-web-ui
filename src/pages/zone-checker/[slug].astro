---
import { getT } from '@/i18n';
import { safe, zone } from '@/features/data-hub/api';
import DetailState from '@/features/data-hub/DetailState.astro';
import { text } from '@/features/data-hub/text';
import { hubName } from '@/features/data-hub/pages';
import { settle, stateOf, validSlug } from '@/features/data-hub/route';
import ZonePage from '@/features/data-hub/ZonePage.astro';

export const prerender = false;

const locale = Astro.locals.locale;
const t = getT(locale);
const slug = Astro.params.slug;
const res = validSlug(slug) ? await safe(() => zone(slug)) : null;
const state = stateOf(res);
settle(Astro, state, 'day');
---

{
  res?.data ? (
    <ZonePage locale={locale} path={`/zone-checker/${slug ?? ''}`} />
  ) : (
    <DetailState
      state={state === 'ok' ? 'missing' : state}
      locale={locale}
      title={locale === 'hi' ? 'ज़ोन रिकॉर्ड | 360Ghar' : 'Zoning record | 360Ghar'}
      missingTitle={text(locale).nf.zone}
      missingBody={t('data-hub:zoneChecker.detail.notFoundDesc')}
      back={{ path: '/zone-checker', label: hubName('zones', locale) }}
    />
  )
}
