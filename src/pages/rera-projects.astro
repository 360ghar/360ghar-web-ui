---
import { settleList } from '@/features/data-hub/route';
import { allRera, reraPage, safe } from '@/features/data-hub/api';
import { RERA, readParams } from '@/features/data-hub/params';
import ReraPage from '@/features/data-hub/ReraPage.astro';

export const prerender = false;

const locale = Astro.locals.locale;
const filters = readParams(Astro.url.searchParams, RERA);
const [page, all] = await Promise.all([safe(() => reraPage(filters, null)), safe(allRera)]);
settleList(Astro, 'hour', page);
---

<ReraPage locale={locale} filters={filters} page={page.data} error={page.error} all={all.data ?? []} />
