---
import { settleList } from '@/features/data-hub/route';
import { buildersPage, safe } from '@/features/data-hub/api';
import BuildersPage from '@/features/data-hub/BuildersPage.astro';
import { BUILDER, readParams } from '@/features/data-hub/params';

export const prerender = false;

const locale = Astro.locals.locale;
const filters = readParams(Astro.url.searchParams, BUILDER);
const page = await safe(() => buildersPage(filters, null));
settleList(Astro, 'day', page);
---

<BuildersPage locale={locale} filters={filters} page={page.data} error={page.error} />
