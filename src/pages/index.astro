---
import HomePage from '@/features/home/HomePage.astro';
import { HERO_PRELOAD_SRCS } from '@/features/home/diorama/layers';
import { loadHome } from '@/features/home/load';
import { getT } from '@/i18n';
import Page from '@/layouts/Page.astro';
import { cachePage } from '@/lib/cache';
import { Toaster } from '@/ui/react/Toaster';

export const prerender = false;

const locale = Astro.locals.locale;
const t = getT(locale);
const data = await loadHome(locale);
cachePage(Astro, 'hour', { error: data.failed });
---

<Page
  title={t('seo:home.title')}
  description={t('seo:home.description')}
  path="/"
  overHero
  image="/og-image-home.jpg"
  jsonLd={[data.faqSchema, data.facts.jsonLd]}
  preloadImages={HERO_PRELOAD_SRCS}
>
  {/* Astro's island scripts sit inside the search sheet; while they wait for the
      stylesheets the parser stops mid-hero, and a first frame without the search
      form made the bottom-pinned search box jump (PageSpeed CLS 0.072,
      docs/perf/psi-100.md). Hold the first render until the whole hero is parsed. */}
  <link slot="head" rel="expect" href="#after-hero" blocking="render" />
  <HomePage locale={locale} data={data} />
  <Toaster client:idle />
</Page>
