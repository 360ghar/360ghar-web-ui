---
import { settleList } from '@/features/data-hub/route';
import { allCircleRates, circleRatesPage, circleSectors, safe } from '@/features/data-hub/api';
import CircleRatesPage from '@/features/data-hub/CircleRatesPage.astro';
import { CIRCLE, readParams } from '@/features/data-hub/params';

export const prerender = false;

const locale = Astro.locals.locale;
const filters = readParams(Astro.url.searchParams, CIRCLE);
const [page, sectors, all] = await Promise.all([safe(() => circleRatesPage(filters, null)), safe(circleSectors), safe(allCircleRates)]);
settleList(Astro, 'day', page, sectors);
---

<CircleRatesPage locale={locale} filters={filters} page={page.data} error={page.error} sectors={sectors.data ?? []} all={all.data ?? []} />
