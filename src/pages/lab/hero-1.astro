---
import HomePage from '@/features/home/HomePage.astro';
import WalkInHero from '@/features/lab/WalkInHero.astro';
import WalkMore from '@/features/lab/WalkMore.astro';
import { loadLab } from '@/features/lab/load';
import Page from '@/layouts/Page.astro';
import { Toaster } from '@/ui/react/Toaster';

// Dev only: hero study, not in the production build.
export const prerender = false;
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const locale = Astro.locals.locale;
const data = await loadLab(locale);
---

<Page title="Lab: Walk in" description="Hero study" path="/lab/hero-1" overHero noindex>
  {
    data.door ? (
      <HomePage locale={locale} data={data}>
        <WalkInHero slot="hero" locale={locale} home={data.door.p} rooms={data.door.rooms} />
        <WalkMore slot="after-hero" locale={locale} walks={data.walks} />
      </HomePage>
    ) : (
      <HomePage locale={locale} data={data} />
    )
  }
  <Toaster client:idle />
</Page>
