---
/**
 * Hero artwork study C: street level, towers and metro dropped. The full home
 * page, with the study hero. Dev only, never in the production build.
 */
import HomePage from '@/features/home/HomePage.astro';
import HomeHero from '@/features/home/hero/HomeHero.astro';
import { loadHome } from '@/features/home/load';
import HeroSwitch from '@/features/lab/HeroSwitch.astro';
import Page from '@/layouts/Page.astro';
import { Toaster } from '@/ui/react/Toaster';

export const prerender = false;
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const locale = Astro.locals.locale;
const data = await loadHome(locale);
---

<Page title="Lab: Hero C" description="Hero study" path="/lab/home-c" overHero noindex>
  <HomePage locale={locale} data={data}>
    <HomeHero slot="hero" locale={locale} data={data} variant="homes" />
  </HomePage>
  <HeroSwitch here="c" />
  <Toaster client:idle />
</Page>
