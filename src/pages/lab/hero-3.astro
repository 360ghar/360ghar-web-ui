---
import HomePage from '@/features/home/HomePage.astro';
import SentenceExamples from '@/features/lab/SentenceExamples.astro';
import SentenceHero from '@/features/lab/SentenceHero.astro';
import { loadLab } from '@/features/lab/load';
import Page from '@/layouts/Page.astro';
import { Toaster } from '@/ui/react/Toaster';

// Dev only: hero study, not in the production build.
export const prerender = false;
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const locale = Astro.locals.locale;
const data = await loadLab(locale);
/** Localities that have homes, most homes first: the place suggestions. */
const counts = new Map<string, number>();
for (const p of data.mapped) if (p.locality) counts.set(p.locality, (counts.get(p.locality) ?? 0) + 1);
const places = [...counts].sort((a, b) => b[1] - a[1]).map(([name]) => name);
---

<Page title="Lab: Sentence" description="Hero study" path="/lab/hero-3" overHero noindex>
  <HomePage locale={locale} data={data}>
    <SentenceHero slot="hero" locale={locale} places={places} />
    <SentenceExamples slot="after-hero" locale={locale} />
  </HomePage>
  <Toaster client:idle />
</Page>
