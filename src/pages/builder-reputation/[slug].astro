---
import { getT } from '@/i18n';
import { builder, safe } from '@/features/data-hub/api';
import { developer } from '@/features/projects/api';
import BuilderPage from '@/features/data-hub/BuilderPage.astro';
import DetailState from '@/features/data-hub/DetailState.astro';
import { text } from '@/features/data-hub/text';
import { hubName } from '@/features/data-hub/pages';
import { settle, stateOf, validSlug } from '@/features/data-hub/route';
import { cachePage } from '@/lib/cache';

export const prerender = false;

const locale = Astro.locals.locale;
const t = getT(locale);
const slug = Astro.params.slug;
// The dossier comes from the project-intelligence API. It is optional: the page keeps
// rendering from the HRERA record alone when that route is absent or has no such slug.
// Both requests start together, so a slow dossier does not wait for the record first.
const [res, dossier] = validSlug(slug) ? await Promise.all([safe(() => builder(slug)), safe(() => developer(slug))]) : [null, null];
const state = stateOf(res);
settle(Astro, state, 'day');
// A dossier that failed for a reason other than "no such developer" is transient: keep the
// page 200, but use the short cache so the dossier comes back soon.
if (state === 'ok' && dossier?.error && dossier.error.kind !== 'not_found') cachePage(Astro, 'day', { error: true });
---

{
  res?.data ? (
    <BuilderPage locale={locale} b={res.data} developer={dossier?.data ?? null} />
  ) : (
    <DetailState
      state={state === 'ok' ? 'missing' : state}
      locale={locale}
      title={state === 'down' ? t('seo:builderReputationDetail.errorTitle') : t('seo:builderReputationDetail.notFoundTitle')}
      missingTitle={text(locale).nf.builder}
      missingBody={t('data-hub:builderReputation.detail.notFoundDesc')}
      back={{ path: '/builder-reputation', label: hubName('builders', locale) }}
    />
  )
}
