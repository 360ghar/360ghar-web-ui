---
import { getT } from '@/i18n';
import { auction, auctionBanks, safe } from '@/features/data-hub/api';
import AuctionPage from '@/features/data-hub/AuctionPage.astro';
import DetailState from '@/features/data-hub/DetailState.astro';
import { text } from '@/features/data-hub/text';
import { hubName } from '@/features/data-hub/pages';
import { settle, stateOf } from '@/features/data-hub/route';

export const prerender = false;

const locale = Astro.locals.locale;
const t = getT(locale);
const raw = Astro.params.id ?? '';
const id = /^\d{1,9}$/.test(raw) ? Number(raw) : null;
// A bad id is a 404 with no API call. The banks are for the page's filter links only.
// Court auctions have their own id space and their own route: /bank-auctions/court/:id.
const [res, banks] = id ? await Promise.all([safe(() => auction(id, 'bank')), auctionBanks()]) : [null, []];
const state = stateOf(res);
settle(Astro, state, 'hour');
---

{
  res?.data ? (
    <AuctionPage locale={locale} a={res.data} banks={banks} />
  ) : (
    <DetailState
      state={state === 'ok' ? 'missing' : state}
      locale={locale}
      title={t('seo:bankAuctionDetail.fallbackTitle')}
      missingTitle={text(locale).nf.auction}
      missingBody={t('data-hub:bankAuctions.detail.notFoundDesc')}
      back={{ path: '/bank-auctions', label: hubName('auctions', locale) }}
    />
  )
}
