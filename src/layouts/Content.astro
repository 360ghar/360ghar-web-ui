---
/**
 * Layout for text pages (guides, policies, compare, careers). A plain H1, an
 * optional one-line lead, then the page body at a readable measure. Pass SEO
 * props through. Breadcrumbs sit above the title.
 */
import type { ComponentProps } from 'astro/types';
import Breadcrumbs from '@/ui/Breadcrumbs.astro';
import NewsletterBand from '@/features/content/shared/NewsletterBand.astro';
import TitleFit from '@/features/content/shared/TitleFit.astro';
import { contentSpeakable } from '@/lib/seo/speakable';
import Page from './Page.astro';

type Props = ComponentProps<typeof Page> & {
  heading: string;
  lead?: string;
  crumbs?: { name: string; path?: string }[];
  wide?: boolean;
  /** Long headings (blog post titles): a smaller size keeps most to two lines on a phone. */
  longHeading?: boolean;
  /** Newsletter band after the body. */
  newsletter?: boolean;
};

const { heading, lead, crumbs, wide = false, longHeading = false, newsletter = false, ...page } = Astro.props;
// Voice-assistant selectors: the h1 and the lead. A page can pass its own `speakable`.
const speakable = page.speakable ?? contentSpeakable(Boolean(lead), page.noindex);
---

<Page {...page} speakable={speakable}>
  <div class="container-page content-page">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <header class="content-head">
      <h1 class:list={['content-h1', longHeading && 'is-long']}>{heading}</h1>
      {lead && <p class="content-lead">{lead}</p>}
      <TitleFit title={heading} long={longHeading} />
      <slot name="head" />
    </header>
    <div class:list={['content-body', wide && 'is-wide']}>
      <slot />
      {newsletter && <NewsletterBand locale={Astro.locals.locale} />}
    </div>
  </div>
</Page>

<style>
  .content-page {
    padding-top: 0.5rem;
  }

  .content-head {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
    max-width: 52rem;
  }

  .content-h1 {
    font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem);
  }

  .content-h1.is-long {
    font-size: clamp(1.625rem, 1.1rem + 2.6vw, 3rem);
  }

  .content-lead {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--color-ink-800);
    max-width: 60ch;
  }

  .content-body {
    margin-top: 2rem;
    max-width: 52rem;
  }

  .content-body.is-wide {
    max-width: none;
  }

  /* Prose inside content pages. */
  .content-body :global(:where(h2)) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .content-body :global(:where(h3)) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    font-weight: 800;
  }

  .content-body :global(:where(p, ul, ol, table)) + :global(:where(p, ul, ol, table)) {
    margin-top: 0.875rem;
  }

  .content-body :global(:where(p, li)) {
    color: var(--color-ink-800);
    max-width: 68ch;
  }

  .content-body :global(:where(ul)) {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .content-body :global(:where(ol)) {
    list-style: decimal;
    padding-left: 1.25rem;
  }

  .content-body :global(:where(li + li)) {
    margin-top: 0.375rem;
  }

  .content-body :global(:where(a:not(.btn))) {
    color: var(--color-kesar-700);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .content-body :global(:where(table)) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .content-body :global(:where(th, td)) {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-ink-200);
    text-align: left;
    vertical-align: top;
  }

  .content-body :global(:where(th)) {
    font-weight: 700;
    background: var(--color-mist-50);
  }

  /* Closing row of buttons and links after a guide. */
  .content-body :global(.page-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }

  .content-body :global(.table-scroll) {
    overflow-x: auto;
    margin-inline: -1rem;
    padding-inline: 1rem;
  }
</style>
