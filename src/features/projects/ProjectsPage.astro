---
/** All projects: a large photo each, what the project lists, and how many live homes match now. */
import Page from '@/layouts/Page.astro';
import { localizePath } from '@/lib/i18n/locale';
import { breadcrumbs } from '@/lib/seo/site';
import { PROJECTS } from '@/features/projects/catalog';
import PlaceFacts from '@/features/localities/PlaceFacts.astro';
import PlaceHero from '@/features/localities/PlaceHero.astro';
import Breadcrumbs from '@/ui/Breadcrumbs.astro';
import Icon from '@/ui/icons/Icon.astro';

type Props = { counts: Record<string, number> | null };
const { counts } = Astro.props;
const locale = Astro.locals.locale;
const hi = locale === 'hi';
const count = (slug: string) => {
  if (!counts) return null;
  const n = counts[slug] ?? 0;
  if (!n) return hi ? 'अभी कोई घर नहीं' : 'No homes yet';
  return hi ? `अभी ${n} घर` : `${n} ${n === 1 ? 'home' : 'homes'} now`;
};
const total = counts ? PROJECTS.filter((p) => (counts[p.slug] ?? 0) > 0).length : null;
const withHomes = counts ? [...PROJECTS].filter((p) => (counts[p.slug] ?? 0) > 0).sort((a, b) => counts[b.slug]! - counts[a.slug]!) : [];
const heroGroups = [
  {
    title: hi ? 'अभी घरों वाले प्रोजेक्ट' : 'Projects with homes now',
    rows: withHomes.slice(0, 4).map((p) => ({ text: hi ? p.titleHi : p.title, value: hi ? `${counts![p.slug]} घर` : `${counts![p.slug]} homes`, href: localizePath(`/project/${p.slug}`, locale) })),
  },
];
---

<Page
  title="Real Estate Projects in Gurugram | 360Ghar"
  description="Browse residential and commercial real estate projects in Gurugram, each with the live, verified homes that match it."
  path="/project"
  jsonLd={[
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Projects', path: '/project' }], locale),
    {
      '@type': 'CollectionPage',
      name: 'Real estate projects in Gurugram',
      url: `https://360ghar.com${localizePath('/project', locale)}`,
      hasPart: PROJECTS.map((p) => ({ '@type': 'WebPage', name: p.title, url: `https://360ghar.com${localizePath(`/project/${p.slug}`, locale)}` })),
    },
  ]}
>
  <div class="container-page pjs">
    <Breadcrumbs items={[{ name: hi ? 'होम' : 'Home', path: '/' }, { name: hi ? 'प्रोजेक्ट' : 'Projects' }]} />
    <PlaceHero kind="project" seed="projects" locale={locale}>
      <h1>{hi ? 'गुरुग्राम के प्रोजेक्ट' : 'Projects in Gurugram'}</h1>
      <p class="pjs-lead">
        {hi ? 'हर प्रोजेक्ट पेज पर उससे मेल खाते लाइव घर दिखते हैं। सूची हर घंटे ताज़ा होती है।' : 'Each project page lists the live homes that match it. The list is refreshed every hour.'}
      </p>
      {
        total !== null && (
          <p class="pjs-live">{hi ? `${PROJECTS.length} में से ${total} प्रोजेक्ट में अभी घर हैं।` : `${total} of the ${PROJECTS.length} projects have homes now.`}</p>
        )
      }
      <PlaceFacts slot="aside" groups={heroGroups} />
    </PlaceHero>

    <ul class="pjs-grid">
      {
        PROJECTS.map((p, i) => (
          <li class="pj-card">
            <div class="pj-print soft-lift is-clip" data-depth="1">
              <div class="pj-img">
                <img src={p.image} alt="" width="630" height="521" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
              </div>
            </div>
            <h2 class="pj-title">
              <a href={localizePath(`/project/${p.slug}`, locale)}>{hi ? p.titleHi : p.title}</a>
            </h2>
            <p class="pj-desc">{hi ? p.descHi : p.desc}</p>
            <p class="pj-foot">
              {count(p.slug) && <span class:list={['pj-count', !(counts?.[p.slug] ?? 0) && 'is-zero']}>{count(p.slug)}</span>}
              <span class="pj-more" aria-hidden="true">
                {hi ? 'प्रोजेक्ट देखें' : 'See the project'} <Icon name="arrow-up-right" size={16} />
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Page>

<style>
  .pjs {
    padding-top: 0.5rem;
  }

  .pjs-lead {
    font-size: 1.0625rem;
    color: var(--color-ink-800);
    max-width: 58ch;
  }

  .pjs-live {
    font-weight: 700;
    color: var(--color-kesar-700);
  }

  /* Cards share row lines (subgrid): photos, titles, text and the foot line up across a row. */
  .pjs-grid {
    display: grid;
    gap: 0 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 40rem) {
    .pjs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .pjs-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  .pj-card {
    position: relative;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .pj-print {
    --tint: 94 33 0;
    margin-bottom: 0.375rem;
  }

  .pj-img {
    aspect-ratio: 630 / 460;
    background: var(--color-mist-100);
  }

  .pj-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 500ms ease-out;
  }

  .pj-card:hover .pj-img img {
    scale: 1.03;
  }

  .pj-title {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  :lang(hi) .pj-title {
    line-height: 1.35;
  }

  .pj-title a {
    text-decoration: none;
  }

  .pj-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .pj-title a:hover {
    color: var(--color-kesar-700);
  }

  .pj-title a:focus-visible {
    outline: none;
  }

  .pj-title a:focus-visible::after {
    outline: 3px solid var(--color-kesar-700);
    outline-offset: 4px;
  }

  .pj-desc {
    color: var(--color-ink-800);
    font-size: 0.9375rem;
  }

  .pj-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    min-height: 44px;
  }

  .pj-count {
    font-weight: 700;
    color: var(--color-kesar-700);
  }

  .pj-count.is-zero {
    font-weight: 600;
    color: var(--color-ink-600);
  }

  .pj-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-kesar-700);
    font-weight: 700;
  }

  .pj-more :global(svg) {
    transition: translate 160ms var(--ease-paper);
  }

  .pj-card:hover .pj-more :global(svg) {
    translate: 2px -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-img img,
    .pj-more :global(svg) {
      transition: none;
    }
  }
</style>
