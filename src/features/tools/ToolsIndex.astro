---
/**
 * /tools: all tools in 4 groups, server-rendered (indexable), with a small
 * client-side filter. Without JavaScript the full list shows.
 */
import Page from '@/layouts/Page.astro';
import { localizePath } from '@/lib/i18n/locale';
import { breadcrumbs, SITE_URL } from '@/lib/seo/site';
import Breadcrumbs from '@/ui/Breadcrumbs.astro';
import Icon from '@/ui/icons/Icon.astro';
import { GROUPS, TOOLS } from './registry';
import Vignette from '@/ui/paper/Vignette.astro';
import { homeCrumb, toolsCrumb } from './seo';
import './tools.css';

const locale = Astro.locals.locale;
const hi = locale === 'hi';
const T = hi
  ? {
      title: 'मुफ़्त प्रॉपर्टी टूल्स और कैलकुलेटर | 360Ghar',
      description: `घर खरीदने, किराये पर लेने और बेचने के लिए ${TOOLS.length} मुफ़्त टूल्स: EMI, लोन पात्रता, कैपिटल गेन्स टैक्स, एरिया कनवर्टर, किराया रसीद, वास्तु चेकर और अन्य।`,
      heading: 'प्रॉपर्टी टूल्स',
      lead: `घर खरीदने, किराये पर लेने और बेचने के लिए ${TOOLS.length} मुफ़्त कैलकुलेटर और जाँच। ज़्यादातर टूल आपके ब्राउज़र में ही चलते हैं।`,
      find: 'टूल खोजें',
      placeholder: 'जैसे EMI, गज, वास्तु',
      count: (n: number) => `${n} टूल्स`,
      none: 'कोई टूल नहीं मिला। कोई दूसरा शब्द आज़माएँ।',
      listName: '360Ghar प्रॉपर्टी टूल्स',
    }
  : {
      title: 'Free Property Tools and Calculators | 360Ghar',
      description: `${TOOLS.length} free tools for buying, renting and selling a home: EMI, loan eligibility, capital gains tax, area converter, rent receipt, Vastu checker and more.`,
      heading: 'Property tools',
      lead: `${TOOLS.length} free calculators and checks for buying, renting and selling a home. Most of them run in your browser.`,
      find: 'Find a tool',
      placeholder: 'For example EMI, gaj, Vastu',
      count: (n: number) => `${n} ${n === 1 ? 'tool' : 'tools'}`,
      none: 'No tool matches. Try another word.',
      listName: '360Ghar property tools',
    };

const itemList = {
  '@type': 'ItemList',
  name: T.listName,
  url: `${SITE_URL}${localizePath('/tools', locale)}`,
  numberOfItems: TOOLS.length,
  itemListElement: TOOLS.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name[locale],
    url: `${SITE_URL}${localizePath(t.route, locale)}`,
  })),
};
// The arrow stays on the line of the last word.
const head = (name: string) => name.slice(0, name.lastIndexOf(' ') + 1);
const tail = (name: string) => name.slice(name.lastIndexOf(' ') + 1);
const search = (t: (typeof TOOLS)[number]) => [t.name.en, t.name.hi, t.desc.en, t.desc.hi, t.route.replace(/[-/]/g, ' ')].join(' ').toLowerCase();
---

<Page title={T.title} description={T.description} path="/tools" jsonLd={[breadcrumbs([homeCrumb(locale), toolsCrumb(locale)], locale), itemList]}>
  <div class="container-page tool-page">
    <Breadcrumbs items={[homeCrumb(locale), { name: toolsCrumb(locale).name }]} />
    <header class="tool-head">
      <div class="tool-head-text">
        <h1 class="tool-h1">{T.heading}</h1>
        <p class="tool-lead">{T.lead}</p>
      </div>
    </header>

    <div class="tool-desk tools-index" data-tools-index>
      <div class="tools-find">
        <label for="tool-filter" class="field-label">{T.find}</label>
        <div class="tools-find-row">
          <input id="tool-filter" class="input" type="search" autocomplete="off" placeholder={T.placeholder} data-tools-filter />
          <p class="tools-count tabular" aria-live="polite" data-tools-count data-one={T.count(1)} data-many={T.count(2).replace('2', '{n}')}>
            {T.count(TOOLS.length)}
          </p>
        </div>
      </div>

      {
        GROUPS.map((g) => (
          <section class="tools-group" aria-labelledby={`group-${g.key}`} data-tools-group>
            <h2 id={`group-${g.key}`} class="tools-group-title">
              {g.name[locale]}
            </h2>
            <ul class="tools-grid">
              {TOOLS.filter((t) => t.group === g.key).map((t) => (
                <li data-tool data-search={search(t)}>
                  <a class="tools-card" href={localizePath(t.route, locale)}>
                    <span class="tools-card-art">
                      <Vignette tool={t.key} />
                    </span>
                    <span class="tools-card-name">
                      {head(t.name[locale])}
                      <span class="whitespace-nowrap">
                        {tail(t.name[locale])}
                        <Icon name="arrow-up-right" size={16} class="arrow" />
                      </span>
                    </span>
                    <span class="tools-card-desc">{t.desc[locale]}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <p class="tools-none" hidden data-tools-none>{T.none}</p>
    </div>
  </div>
</Page>

<script>
  const root = document.querySelector<HTMLElement>('[data-tools-index]');
  const input = root?.querySelector<HTMLInputElement>('[data-tools-filter]');
  const count = root?.querySelector<HTMLElement>('[data-tools-count]');
  const none = root?.querySelector<HTMLElement>('[data-tools-none]');
  const apply = () => {
    if (!root || !input || !count || !none) return;
    const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    root.querySelectorAll<HTMLElement>('[data-tools-group]').forEach((group) => {
      let inGroup = 0;
      group.querySelectorAll<HTMLElement>('[data-tool]').forEach((item) => {
        const hay = item.dataset.search ?? '';
        const match = words.every((w) => hay.includes(w));
        item.hidden = !match;
        if (match) inGroup += 1;
      });
      group.hidden = inGroup === 0;
      shown += inGroup;
    });
    none.hidden = shown > 0;
    count.textContent = shown === 1 ? (count.dataset.one ?? '1') : (count.dataset.many ?? '{n}').replace('{n}', String(shown));
  };
  input?.addEventListener('input', apply);
  // A value restored by the browser (Back button) filters the list too.
  if (input?.value) apply();
</script>

<style>
  .tools-index {
    gap: 2rem;
  }

  .tools-find {
    display: grid;
    gap: 0.375rem;
    max-width: 36rem;
  }

  .tools-find-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
  }

  .tools-count {
    color: var(--color-ink-800);
    font-weight: 600;
    white-space: nowrap;
  }

  .tools-group {
    display: grid;
    gap: 0.875rem;
  }

  .tools-group-title {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .tools-grid {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .tools-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tools-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .tools-grid > li {
    display: grid;
  }

  /* Phones: the scene sits beside the text. From 640 px it heads the card. */
  .tools-card {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: 0.25rem 0.875rem;
    align-content: start;
    min-height: 100%;
    padding: 0.75rem 1rem 0.875rem 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    box-shadow: 0 1px 1px rgb(var(--tint) / 0.06), 0 6px 14px -6px rgb(var(--tint) / 0.16);
    color: inherit;
    text-decoration: none;
    transition: background-color 140ms var(--ease-paper);
  }

  .tools-card-art {
    grid-row: span 2;
    align-self: start;
    aspect-ratio: 240 / 150;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  @media (min-width: 40rem) {
    .tools-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      padding: 0 0 1.125rem;
    }

    .tools-card-art {
      grid-row: auto;
      aspect-ratio: 300 / 150;
      margin-bottom: 0.625rem;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .tools-card-name,
    .tools-card-desc {
      padding-inline: 1.125rem;
    }
  }

  .tools-card:hover {
    background: var(--color-mist-50);
  }

  .tools-card:active {
    translate: 1px 1px;
    box-shadow: 0 0 0 rgb(var(--tint) / 0);
  }

  /* On hover the paper layers part a little, nearer ones more, as if lifted off the card. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tools-card :global(.vg-layer) {
      transition: translate 260ms var(--ease-paper);
    }

    .tools-card:hover :global(.vg-layer),
    .tools-card:focus-visible :global(.vg-layer) {
      translate: calc(var(--i) * -0.9px) calc(var(--i) * -1.4px);
    }
  }

  .tools-card-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .tools-card:hover .tools-card-name {
    color: var(--color-kesar-700);
  }

  .tools-card :global(.arrow) {
    margin-left: 0.25rem;
    transition: translate 160ms var(--ease-paper);
  }

  .tools-card:hover :global(.arrow) {
    translate: 2px -2px;
  }

  .tools-card-desc {
    color: var(--color-ink-600);
    font-size: 0.9375rem;
  }

  .tools-none {
    color: var(--color-ink-800);
    font-weight: 600;
  }
</style>
