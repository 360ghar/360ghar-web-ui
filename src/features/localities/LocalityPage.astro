---
/**
 * Locality guide. A paper vignette of the kind of place, the live homes
 * matched exactly to this place, listing prices, a checklist for this kind
 * of place, FAQs and nearby places.
 */
import { compactPrice, formatNum, rupees } from '@/lib/format';
import type { Locale } from '@/lib/i18n/locale';
import { localizer } from '@/lib/i18n/locale';
import FavouriteButton from '@/features/favourites/FavouriteButton';
import { CITY_META } from '@/features/landing/cities';
import { PropertyCardView } from '@/features/property/PropertyCardView';
import Breadcrumbs from '@/ui/Breadcrumbs.astro';
import AskAbout from '@/features/chat/AskAbout.astro';
import type { Generated } from '@/features/content/generated/load';
import Provenance from '@/ui/Provenance.astro';
import CutBand from '@/ui/CutBand.astro';
import Faq from '@/ui/Faq.astro';
import Icon from '@/ui/icons/Icon.astro';
import StateBlock from '@/ui/states/StateBlock.astro';
import { citySlug, displayName, INTENT_TYPES, localitySlug, nearbyLocalities, TYPE_LABEL, type Locality } from './data';
import ListedPlaces from './ListedPlaces.astro';
import { PRICE_ON_REQUEST } from '@/features/search/prices';
import { summarize, type Range } from './live';
import PlaceFacts, { type FactRow } from './PlaceFacts.astro';
import type { LocalityData } from './load';
import PlaceHero from './PlaceHero.astro';
import { kindForEntity } from './vignette';

type Props = { locality: Locality; data: LocalityData; faqs: { q: string; a: string }[]; generated?: Generated | null; locale: Locale };

const { locality: l, data, faqs, generated = null, locale } = Astro.props;
const { homes, listed, nearbyCounts, failed } = data;
const hi = locale === 'hi';
const L = localizer(locale);
const name = displayName(l.name);
const city = citySlug(l.city);
const meta = CITY_META[city];
const cityName = city === 'gurgaon' ? (hi ? 'गुरुग्राम' : 'Gurugram') : displayName(l.city);
const type = TYPE_LABEL[l.entityType]?.[hi ? 1 : 0] ?? l.type;
const slug = localitySlug(l);
const nearby = nearbyLocalities(l);
const hasIntent = INTENT_TYPES.has(l.entityType);
const sum = summarize(homes);
const n = (x: number) => formatNum(x, 'en');
const money = (v: number) => compactPrice(v, locale);
const rent = (v: number) => rupees(v, locale);

// Facts in the header use only live listing counts and asking prices.
const roundRent = (v: number) => Math.round(v / 100) * 100;
const priceLine = (r: Range, count: string, f: (v: number) => string, per = '') =>
  r.lo !== null && r.hi !== null
    ? hi
      ? `${count} · लिस्टिंग की कीमतें ${f(r.lo)} से ${f(r.hi)}${per}`
      : `${count} · listed prices ${f(r.lo)} to ${f(r.hi)}${per}`
    : r.min !== null
      ? hi
        ? `${count} · लिस्टिंग की कीमत ${f(r.min)}${per} से`
        : `${count} · listed price from ${f(r.min)}${per}`
      : `${count} · ${PRICE_ON_REQUEST[hi ? 'hi' : 'en'].toLowerCase()}`;
const live: FactRow[] = failed
  ? [{ text: hi ? 'लाइव घर अभी लोड नहीं हो सके' : 'Live homes could not load right now', strong: true }]
  : !sum.total
    ? [{ text: hi ? 'अभी कोई घर लिस्ट नहीं' : 'No homes listed yet', strong: true }]
    : [
        { text: hi ? `${n(sum.total)} घर लिस्ट` : `${n(sum.total)} ${sum.total === 1 ? 'home' : 'homes'} listed`, strong: true },
        ...(sum.buy ? [{ text: priceLine(sum.buy, hi ? `${sum.buy.n} बिक्री के लिए` : `${sum.buy.n} for sale`, money) }] : []),
        ...(sum.rent ? [{ text: priceLine(sum.rent, hi ? `${sum.rent.n} किराये पर` : `${sum.rent.n} for rent`, (v) => rent(roundRent(v)), hi ? ' माह' : ' a month') }] : []),
        ...(sum.stay ? [{ text: priceLine({ ...sum.stay, lo: null, hi: null }, hi ? `${sum.stay.n} कम समय के लिए` : `${sum.stay.n} short ${sum.stay.n === 1 ? 'stay' : 'stays'}`, rent, hi ? ' रात' : ' a night') }] : []),
      ];
const heroGroups = [
  { title: hi ? '360Ghar पर अभी' : 'Live on 360Ghar', rows: live },
];

// A short summary built only from facts on this page.
const WORD: Record<string, [string, string]> = {
  sector: ['a sector', 'एक सेक्टर'],
  locality: ['a locality', 'एक इलाका'],
  phase: ['a phase of a larger colony', 'एक बड़ी कॉलोनी का फ़ेज़'],
  society: ['a housing society', 'एक हाउसिंग सोसाइटी'],
  project: ['a housing project', 'एक हाउसिंग प्रोजेक्ट'],
  township: ['a township', 'एक टाउनशिप'],
  road: ['a road', 'एक सड़क'],
  village: ['a village', 'एक गाँव'],
};
const word = WORD[l.entityType]?.[hi ? 1 : 0] ?? (hi ? 'एक जगह' : 'a place');
const state = meta ? (hi ? meta.stateHi : meta.state) : '';
const summary = [
  hi ? `${name} ${cityName}${state && state !== cityName ? `, ${state}` : ''} में ${word} है।` : `${name} is ${word} in ${cityName}${state && state !== cityName ? `, ${state}` : ''}.`,
  !failed && (sum.total ? (hi ? `अभी 360Ghar पर यहाँ ${n(sum.total)} घर लिस्ट हैं।` : `${n(sum.total)} ${sum.total === 1 ? 'home is' : 'homes are'} listed here on 360Ghar now.`) : hi ? 'अभी 360Ghar पर यहाँ कोई घर लिस्ट नहीं है।' : 'No homes are listed here on 360Ghar yet.'),
]
  .filter(Boolean)
  .join(' ');

// What to check for this kind of place (from the old site's sidebar), with the tools that help.
const CHECKS: Record<string, [string, string][]> = {
  area: [
    ['Check official records for the approvals that apply to the property. This page does not verify them.', 'प्रॉपर्टी पर लागू मंज़ूरियों के आधिकारिक रिकॉर्ड देखें। यह पेज उनकी पुष्टि नहीं करता।'],
    ['Visit at peak hours to see the traffic, the parking and the water supply.', 'भीड़ के समय जाकर ट्रैफ़िक, पार्किंग और पानी की सप्लाई देखें।'],
    ['Ask for the title papers and the latest property tax receipt.', 'मालिकाना काग़ज़ और ताज़ा प्रॉपर्टी टैक्स की रसीद माँगें।'],
  ],
  society: [
    ['Ask the RWA or the seller for the latest maintenance bill and what it covers.', 'RWA या विक्रेता से ताज़ा मेंटेनेंस बिल और उसमें क्या शामिल है, यह माँगें।'],
    ['Check the parking allotment and the visitor parking rules.', 'पार्किंग का आवंटन और मेहमानों की पार्किंग के नियम देखें।'],
    ['Confirm the power backup for the flat and the common areas.', 'फ़्लैट और कॉमन एरिया का पावर बैकअप पक्का करें।'],
    ['Ask how old the society is and which large repairs are planned.', 'पूछें कि सोसाइटी कितनी पुरानी है और कौन-सी बड़ी मरम्मत होनी है।'],
  ],
  project: [
    ['Check official project records with the relevant authority. This page does not verify registration or approved plans.', 'संबंधित प्राधिकरण के आधिकारिक प्रोजेक्ट रिकॉर्ड देखें। यह पेज रजिस्ट्रेशन या मंज़ूर नक्शों की पुष्टि नहीं करता।'],
    ['Compare the documents provided with the property and phase you plan to buy.', 'मिले दस्तावेज़ों की तुलना उस प्रॉपर्टी और फ़ेज़ से करें जिसे आप खरीदना चाहते हैं।'],
    ['Ask for the builder and project details in writing.', 'बिल्डर और प्रोजेक्ट की जानकारी लिखित में माँगें।'],
    ['Compare the full cost: base price, PLC, EDC and IDC, club and maintenance deposit.', 'पूरी लागत की तुलना करें: बेस कीमत, PLC, EDC और IDC, क्लब और मेंटेनेंस डिपॉज़िट।'],
  ],
  township: [
    ['Check which phases are delivered and which are still being built.', 'देखें कि कौन-से फ़ेज़ तैयार हैं और कौन-से अभी बन रहे हैं।'],
    ['Compare the amenities promised with the ones that work today.', 'वादा की गई सुविधाओं की तुलना आज चालू सुविधाओं से करें।'],
    ['Check the width of the internal roads and the parking.', 'अंदर की सड़कों की चौड़ाई और पार्किंग देखें।'],
    ['Ask who runs the maintenance and what it costs.', 'पूछें कि रखरखाव कौन करता है और उसका शुल्क कितना है।'],
  ],
  road: [
    ['Visit at peak hours to judge the noise and the traffic.', 'शोर और ट्रैफ़िक परखने के लिए भीड़ के समय जाएँ।'],
    ['Check the protection from dust and noise: trees, setbacks, window seals.', 'धूल और शोर से बचाव देखें: पेड़, सड़क से दूरी, खिड़कियों की सील।'],
    ['Check the parking. Road-facing buildings often have little.', 'पार्किंग देखें। सड़क की तरफ़ की इमारतों में अक्सर कम होती है।'],
    ['Walk to the nearest shops and the bus or metro stop.', 'पास की दुकानों और बस या मेट्रो स्टॉप तक पैदल जाकर देखें।'],
  ],
  village: [
    ['Check the land record (jamabandi) and the khasra number.', 'ज़मीन का रिकॉर्ड (जमाबंदी) और खसरा नंबर देखें।'],
    ['Check that the area is inside the municipal limit and has an approved access road.', 'जाँचें कि इलाका नगर निगम सीमा में है और पहुँच की सड़क मंज़ूर है।'],
    ['Confirm the water, sewer and power connections.', 'पानी, सीवर और बिजली के कनेक्शन पक्के करें।'],
    ['Have a lawyer check the title before you pay.', 'पैसे देने से पहले किसी वकील से मालिकाना हक जँचवाएँ।'],
  ],
};
const checkKey = ({ sector: 'area', locality: 'area', phase: 'township', society: 'society', project: 'project', township: 'township', road: 'road', village: 'village' } as Record<string, string>)[l.entityType] ?? 'area';
const checks = CHECKS[checkKey]!.map((c) => c[hi ? 1 : 0]);
const tools = [
  checkKey === 'village' && { href: '/verify-ownership', label: hi ? 'मालिकाना हक जाँचें' : 'Verify ownership' },
  { href: '/emi-calculator', label: hi ? 'EMI कैलकुलेटर' : 'EMI calculator' },
].filter(Boolean) as { href: string; label: string }[];
const shown = homes.slice(0, 6);
// The main action goes where the homes are: rent first when a place has homes for rent only.
const first = !sum.buy && sum.rent ? 'rent' : 'buy';
const second = first === 'buy' ? 'rent' : 'buy';
const buyCount = homes.filter((p) => p.purpose === 'buy').length;
const rentCount = homes.filter((p) => p.purpose === 'rent').length;
---

<div class="container-page loc">
  <Breadcrumbs items={[{ name: hi ? 'होम' : 'Home', path: '/' }, { name: hi ? 'लोकेलिटीज़' : 'Localities', path: '/localities' }, { name }]} />

  <PlaceHero kind={kindForEntity(l.entityType)} seed={slug} locale={locale} sign={l.entityType === 'sector' ? name : undefined} titleLength={name.length}>
    <h1>{name}</h1>
    <p class="loc-type">{type} · {cityName}</p>
    {generated && <p class="loc-lede">{generated.summary}</p>}
    {
      hasIntent && (
        <div class="loc-actions">
          <a class="btn btn-primary" href={L(`/locality/${slug}/${first}`)}>
            {first === 'buy' ? (hi ? `${name} में घर खरीदें` : `Buy in ${name}`) : hi ? `${name} में किराये पर घर` : `Rent in ${name}`}
            <Icon name="arrow-up-right" size={18} class="arrow" />
          </a>
          <a class="link" href={L(`/locality/${slug}/${second}`)}>
            {second === 'buy' ? (hi ? `${name} में घर खरीदें` : `Buy in ${name}`) : hi ? `${name} में किराये पर घर` : `Rent in ${name}`}
          </a>
        </div>
      )
    }
    <PlaceFacts slot="aside" groups={heroGroups} />
  </PlaceHero>

  <section class="loc-block" aria-labelledby="loc-homes">
    {
      shown.length > 0 ? (
        <>
          <div class="loc-row">
            <h2 id="loc-homes" class="loc-h2">{hi ? `${name} में घर` : `Homes in ${name}`}</h2>
            {hasIntent && (
              <p class="loc-more">
                {buyCount > 0 && (
                  <a class="link" href={L(`/locality/${slug}/buy`)}>
                    {hi ? `सभी ${buyCount} बिक्री वाले` : `All ${buyCount} for sale`}
                  </a>
                )}
                {rentCount > 0 && (
                  <a class="link" href={L(`/locality/${slug}/rent`)}>
                    {hi ? `सभी ${rentCount} किराये वाले` : `All ${rentCount} for rent`}
                  </a>
                )}
              </p>
            )}
          </div>
          <ul class="loc-grid">
            {shown.map((p) => (
              <li>
                <PropertyCardView property={p} locale={locale}>
                  <FavouriteButton slot="favourite" client:visible propertyId={p.id} locale={locale} />
                </PropertyCardView>
              </li>
            ))}
          </ul>
        </>
      ) : failed ? (
        <div class="sheet">
          <StateBlock
            scene="offline"
            level={2}
            title={hi ? 'अभी घर लोड नहीं हो सके' : 'We could not load homes right now'}
            body={hi ? 'थोड़ी देर बाद फिर देखें, या पूरे शहर में खोजें।' : 'Try again in a few minutes, or search the whole city.'}
            action={{ href: L('/properties'), label: hi ? 'घर खोजें' : 'Search homes', icon: 'search' }}
          />
        </div>
      ) : (
        <>
          <h2 id="loc-homes" class="loc-h2">{hi ? `${name} में अभी कोई घर लिस्ट नहीं है` : `No homes are listed in ${name} yet`}</h2>
          <p class="loc-note">
            {hi ? 'दूसरे लोकैलिटी पेज देखें, या ' : 'Browse other locality pages, or '}
            <a class="link" href={L('/post-property')}>{hi ? 'अपनी प्रॉपर्टी की जानकारी दें' : 'share your property details'}</a>
            {hi ? '।' : '.'}
          </p>
          {listed.length > 0 && <ListedPlaces places={listed} locale={locale} />}
        </>
      )
    }
  </section>
</div>

<CutBand seed={`loc-${l.slug}`} class="loc-band" labelledby="loc-about">
  <div class="container-page loc-about">
    <h2 id="loc-about" class="loc-h2">{hi ? `${name} के बारे में` : `About ${name}`}</h2>
    <div class="loc-about-grid">
      <div class="loc-summary">
        {/* The generated summary is in the header; the fact-built one stays only without it. */}
        {!generated && <p>{summary}</p>}
        {
          generated && generated.highlights.length > 0 && (
            <ul class="loc-highlights">
              {generated.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )
        }
        {generated && <div class="loc-verified"><Provenance date={generated.date} sources={generated.sources} /></div>}
      </div>
    </div>
  </div>
</CutBand>

<div class="container-page">
  <section class="loc-block loc-check" aria-labelledby="loc-check">
    <div>
      <h2 id="loc-check" class="loc-h2">{hi ? 'फ़ैसले से पहले जाँचें' : 'Check before you decide'}</h2>
      <ol class="loc-steps">
        {checks.map((c) => <li>{c}</li>)}
      </ol>
    </div>
    <div class="loc-side">
      <ul class="loc-tools">
        {
          tools.map((t) => (
            <li>
              <a href={L(t.href)}>
                <span>{t.label}</span>
                <Icon name="arrow-up-right" size={18} class="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="loc-block">
    <AskAbout kind="locality" slug={l.slug} name={name} locale={locale} />
  </section>

  <section class="loc-block">
    <Faq items={faqs} title={hi ? `${name} के बारे में सवाल` : `Questions about ${name}`} id="loc-faq" />
  </section>

  {
    nearby.length > 0 && (
      <section class="loc-block" aria-labelledby="loc-nearby">
        <h2 id="loc-nearby" class="loc-h2">{hi ? 'आस-पास और मिलती-जुलती जगहें' : 'Nearby and similar places'}</h2>
        <ul class="loc-links">
          {nearby.map((x) => (
            <li>
              <a href={L(`/locality/${localitySlug(x)}`)}>
                <span>{displayName(x.name)}</span>
                {nearbyCounts[x.slug] ? <span class="loc-count">{hi ? `${nearbyCounts[x.slug]} घर` : `${nearbyCounts[x.slug]} ${nearbyCounts[x.slug] === 1 ? 'home' : 'homes'}`}</span> : null}
                <Icon name="chevron-right" size={18} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .loc {
    padding-top: 0.5rem;
  }

  .loc-type {
    font-weight: 600;
    color: var(--color-ink-600);
  }

  .loc-lede {
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink-800);
  }

  .loc-highlights {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    list-style: disc;
    display: grid;
    gap: 0.35rem;
    max-width: 62ch;
  }

  .loc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 0.25rem;
  }

  .loc-block {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .loc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0 2rem;
    margin-bottom: 1rem;
  }

  .loc-row .loc-h2 {
    margin-bottom: 0;
  }

  .loc-more {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .loc-h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    margin-bottom: 1rem;
  }

  .loc-note {
    margin: -0.25rem 0 1.5rem;
    color: var(--color-ink-800);
    max-width: 62ch;
  }

  .loc-note .link {
    display: inline;
  }

  .loc-grid {
    display: grid;
    gap: 2rem 1.5rem;
  }

  @media (min-width: 40rem) {
    .loc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .loc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  :global(.loc-band) {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .loc-about {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .loc-about-grid {
    display: grid;
    gap: 2rem 3rem;
  }

  @media (min-width: 56rem) {
    .loc-about-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .loc-summary > p {
    font-size: 1.0625rem;
    color: var(--color-ink-950);
    max-width: 58ch;
  }

  .loc-verified {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-ink-800);
  }

  .loc-check {
    display: grid;
    gap: 2rem 4rem;
  }

  @media (min-width: 56rem) {
    .loc-check {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .loc-steps {
    display: grid;
    gap: 0.875rem;
    counter-reset: step;
    max-width: 62ch;
  }

  .loc-steps li {
    position: relative;
    padding-left: 2.5rem;
    color: var(--color-ink-800);
    counter-increment: step;
  }

  .loc-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.125rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-kesar-700);
  }

  .loc-side {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  .loc-tools a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    border-bottom: 1px solid var(--color-ink-200);
    font-weight: 600;
    text-decoration: none;
  }

  .loc-tools a:hover {
    color: var(--color-kesar-700);
  }

  .loc-tools a :global(.arrow) {
