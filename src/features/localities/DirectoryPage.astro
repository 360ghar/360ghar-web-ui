---
/**
 * All localities, grouped A to Z. Static HTML (good for crawling and fast);
 * a few lines of script filter the list by name and type. The places that
 * have live homes come first, with a real listing photo and the count.
 */
import Page from '@/layouts/Page.astro';
import { formatNum } from '@/lib/format';
import { localizer } from '@/lib/i18n/locale';
import { breadcrumbs } from '@/lib/seo/site';
import { LISTED_LOCALITIES, displayName, localitySlug, TYPE_LABEL } from '@/features/localities/data';
import type { ListedPlace } from '@/features/localities/live';
import Breadcrumbs from '@/ui/Breadcrumbs.astro';
import Icon from '@/ui/icons/Icon.astro';
import DirectoryList from './DirectoryList.astro';
import ListedPlaces from './ListedPlaces.astro';
import PlaceHero from './PlaceHero.astro';

type Props = { listed: ListedPlace[] | null };
const { listed } = Astro.props;
const locale = Astro.locals.locale;
const hi = locale === 'hi';
const L = localizer(locale);
const live = new Map((listed ?? []).map((x) => [x.locality, x.homes.length]));
const items = [...LISTED_LOCALITIES]
  .map((l) => ({ name: displayName(l.name), href: L(`/locality/${localitySlug(l)}`), type: l.entityType, city: l.city, live: live.get(l) ?? 0 }))
  .sort((a, b) => a.name.localeCompare(b.name, 'en', { numeric: true }));
const groups = new Map<string, typeof items>();
for (const it of items) {
  const ch = /[a-z]/i.test(it.name[0] ?? '') ? it.name[0]!.toUpperCase() : '#';
  groups.set(ch, [...(groups.get(ch) ?? []), it]);
}
const letters = [...groups.keys()].sort((a, b) => (a === '#' ? -1 : b === '#' ? 1 : a.localeCompare(b)));
const total = items.length;
const count = (t: string) => items.filter((i) => i.type === t).length;
const types = Object.entries(TYPE_LABEL)
  .map(([k, v]) => ({ key: k, label: v[hi ? 1 : 0], n: count(k) }))
  .filter((t) => t.n > 0)
  .sort((a, b) => b.n - a.n);
const fmt = (n: number) => formatNum(n, 'en');
const MIX: Record<string, [string, string]> = {
  project: ['Projects', 'प्रोजेक्ट'],
  sector: ['Sectors', 'सेक्टर'],
  locality: ['Localities', 'लोकेलिटी'],
  society: ['Societies', 'सोसाइटी'],
  village: ['Villages', 'गाँव'],
  road: ['Roads', 'सड़कें'],
  township: ['Townships', 'टाउनशिप'],
  phase: ['Phases', 'फ़ेज़'],
};
const featured = ['dlf-phase-1', 'golf-course-road', 'sohna-road', 'sushant-lok-1', 'sector-56', 'palam-vihar']
  .map((s) => LISTED_LOCALITIES.find((l) => l.slug === s))
  .filter(Boolean);
const withHomes = (listed ?? []).length;
const homeCount = (listed ?? []).reduce((n, x) => n + x.homes.length, 0);
---

<Page
  title={hi ? 'गुरुग्राम की लोकेलिटीज़, सेक्टर और सोसाइटी | 360Ghar' : 'Localities in Gurugram: Sectors, Societies & Projects | 360Ghar'}
  description={hi ? `गुरुग्राम की ${fmt(total)} लोकेलिटीज़, सेक्टर, सोसाइटी और प्रोजेक्ट की गाइड।` : `Guides to ${fmt(total)} localities, sectors, societies and projects in Gurugram and NCR, with live homes for sale and rent.`}
  path="/localities"
  jsonLd={[
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Localities', path: '/localities' }], locale),
    {
      '@type': 'ItemList',
      name: 'Popular localities in Gurugram',
      itemListElement: featured.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: displayName(l!.name), url: `https://360ghar.com${L(`/locality/${localitySlug(l!)}`)}` })),
    },
  ]}
>
  <div class="container-page dir">
    <Breadcrumbs items={[{ name: hi ? 'होम' : 'Home', path: '/' }, { name: hi ? 'लोकेलिटीज़' : 'Localities' }]} />

    <PlaceHero kind="directory" seed="localities" locale={locale}>
      <h1>{hi ? 'लोकेलिटीज़' : 'Localities'}</h1>
      <p class="dir-lead">
        {hi ? `गुरुग्राम और NCR की ${fmt(total)} जगहें: सेक्टर, सोसाइटी, प्रोजेक्ट, गाँव, सड़कें और टाउनशिप। हर जगह की अपनी गाइड है।` : `${fmt(total)} places in Gurugram and NCR: sectors, societies, projects, villages, roads and townships. Each has its own guide.`}
      </p>
      {
        withHomes > 0 && (
          <p class="dir-live-line">
            {hi ? `अभी ${withHomes} जगहों पर ${homeCount} घर लिस्ट हैं।` : `${homeCount} homes are listed now, in ${withHomes} of these places.`}
          </p>
        )
      }
      <div slot="aside" class="dir-mix">
        <p class="dir-mix-title">{hi ? 'प्रकार से देखें' : 'Browse by type'}</p>
        <ul>
          {
            types.map((t) => (
              <li>
                <a href="#dir-all" data-pick={t.key}>
                  <span>{MIX[t.key]?.[hi ? 1 : 0] ?? t.label}</span>
                  <span class="dir-mix-n tabular">{fmt(t.n)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </PlaceHero>

    {
      withHomes > 0 && (
        <section class="dir-block" aria-labelledby="dir-listed">
          <h2 id="dir-listed" class="dir-h2">{hi ? 'जहाँ अभी घर लिस्ट हैं' : 'Where homes are listed now'}</h2>
          <ListedPlaces places={listed!.slice(0, 8)} locale={locale} />
        </section>
      )
    }

    <section class="dir-block" aria-labelledby="dir-all">
      <h2 id="dir-all" class="dir-h2">{hi ? 'सभी जगहें, A से Z' : 'Every place, A to Z'}</h2>
      <div class="dir-tools" data-dir>
        <div class="dir-bar">
          <label class="dir-search">
            <span class="visually-hidden">{hi ? 'लोकेलिटी का नाम' : 'Locality name'}</span>
            <Icon name="search" size={18} />
            <input class="input" type="search" placeholder={hi ? 'जैसे सेक्टर 57' : 'e.g. Sector 57'} data-dir-q autocomplete="off" />
          </label>
          <p class="dir-count" aria-live="polite" data-dir-count>{hi ? `${fmt(total)} नतीजे` : `${fmt(total)} results`}</p>
        </div>
        <div class="dir-types" role="group" aria-label={hi ? 'प्रकार' : 'Type'}>
          <button type="button" class="toggle" aria-pressed="true" data-dir-type="">
            {hi ? 'सभी' : 'All'} <span class="dir-tn">{fmt(total)}</span>
          </button>
          {
            types.map((t) => (
              <button type="button" class="toggle" aria-pressed="false" data-dir-type={t.key}>
                {t.label} <span class="dir-tn">{fmt(t.n)}</span>
              </button>
            ))
          }
        </div>
      </div>

      <nav class="dir-letters" aria-label={hi ? 'अक्षर' : 'Letters'}>
        {letters.map((ch) => <a href={`#dir-${ch === '#' ? 'num' : ch}`} data-letter={ch === '#' ? 'num' : ch}>{ch}</a>)}
      </nav>

      <DirectoryList groups={groups} letters={letters} locale={locale} />
      <p class="dir-none" data-dir-none hidden>{hi ? 'कोई लोकेलिटी नहीं मिली। कम शब्द लिखकर देखें।' : 'No locality matches. Try fewer words.'}</p>
    </section>
  </div>
</Page>

<style>
  .dir {
    padding-top: 0.5rem;
  }

  .dir-lead {
    font-size: 1.0625rem;
    color: var(--color-ink-800);
    max-width: 58ch;
  }

  .dir-live-line {
    font-weight: 700;
    color: var(--color-kesar-700);
  }

  .dir-mix {
    display: grid;
    gap: 0.375rem;
  }

  .dir-mix-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-600);
  }

  .dir-mix ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
  }

  .dir-mix a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 44px;
    border-bottom: 1px solid var(--color-ink-100);
    color: var(--color-ink-800);
    font-weight: 600;
    text-decoration: none;
  }

  .dir-mix a:hover {
    color: var(--color-kesar-700);
  }

  .dir-mix-n {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink-950);
  }

  .dir-block {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .dir-h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    margin-bottom: 1rem;
  }

  .dir-tools {
    position: sticky;
    top: 64px;
    z-index: 5;
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 0;
    background: var(--color-paper);
  }

  .dir-bar {
    display: grid;
    grid-template-columns: minmax(0, 36rem) auto;
    justify-content: start;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .dir-search {
    position: relative;
    display: block;
  }

  .dir-search :global(svg) {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--color-ink-600);
  }

  .dir-search .input {
    padding-left: 2.5rem;
  }

  .dir-count {
    color: var(--color-ink-600);
    font-weight: 600;
    white-space: nowrap;
  }

  /* One row of type buttons. On phones the row scrolls inside itself. */
  .dir-types {
    display: flex;
    gap: 0.375rem;
    contain: inline-size;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .dir-types .toggle {
    flex: none;
  }

  .dir-tn {
    font-weight: 500;
    color: var(--color-ink-600);
  }

  .dir-types .toggle[aria-pressed='true'] .dir-tn {
    color: var(--color-kesar-200);
  }

  /* Phones: one row of letters that scrolls inside itself. */
  .dir-letters {
    display: flex;
    gap: 0;
    margin-top: 0.25rem;
    contain: inline-size;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .dir-letters a {
    flex: none;
  }

  @media (min-width: 64rem) {
    .dir-letters {
      flex-wrap: wrap;
      contain: none;
    }
  }

  .dir-letters a {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .dir-letters a:hover {
    background: var(--color-mist-50);
    color: var(--color-kesar-700);
  }

  .dir :global(.dir-group) {
    margin-top: 2rem;
    scroll-margin-top: 190px;
  }

  .dir :global(.dir-letter) {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
    font-size: 2rem;
    color: var(--color-kesar-700);
  }

  .dir :global(.dir-gn) {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-600);
  }

  .dir :global(.dir-list) {
    columns: 1;
    column-gap: 2rem;
  }

  @media (min-width: 40rem) {
    .dir :global(.dir-list) {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .dir :global(.dir-list) {
      columns: 3;
    }
  }

  .dir :global(.dir-list li) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    break-inside: avoid;
  }

  .dir :global(.dir-list a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 4px;
    text-decoration: none;
    color: var(--color-ink-800);
  }

  .dir :global(.dir-list a:hover) {
    color: var(--color-kesar-700);
    text-decoration: underline;
  }

  .dir :global(.dir-list span) {
    font-size: 0.8125rem;
    color: var(--color-ink-600);
  }

  .dir :global(.dir-list .dir-live) {
    font-weight: 700;
    color: var(--color-kesar-700);
  }

  .dir :global(.dir-groups[data-type] .dir-t) {
    display: none;
  }

  .dir-none {
    margin-top: 2rem;
    color: var(--color-ink-600);
  }
</style>

<script>
  import { formatNum } from '@/lib/format';

  const root = document.querySelector<HTMLElement>('[data-dir]');
  const list = document.querySelector<HTMLElement>('[data-dir-root]');
  if (root && list) {
    const q = root.querySelector<HTMLInputElement>('[data-dir-q]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-dir-type]')];
    const count = root.querySelector<HTMLElement>('[data-dir-count]')!;
    const none = document.querySelector<HTMLElement>('[data-dir-none]')!;
    const rows = [...list.querySelectorAll<HTMLElement>('[data-n]')];
    const groups = [...list.querySelectorAll<HTMLElement>('[data-group]')];
    const letters = new Map([...document.querySelectorAll<HTMLElement>('[data-letter]')].map((a) => [a.dataset.letter, a]));
    const hi = document.documentElement.lang.startsWith('hi');
    const fmt = (n: number) => formatNum(n, 'en');

    let type = '';
    let t = 0;
    const run = () => {
      const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const r of rows) {
        const ok = (!type || r.dataset.t === type) && words.every((w) => r.dataset.n!.includes(w));
        r.hidden = !ok;
        if (ok) shown += 1;
      }
      for (const g of groups) {
        const n = g.querySelectorAll('[data-n]:not([hidden])').length;
        g.hidden = n === 0;
        g.querySelector('[data-gn]')!.textContent = fmt(n);
        const letter = letters.get(g.id.slice(4));
        if (letter) letter.hidden = n === 0;
      }
      if (type) list.dataset.type = type;
      else delete list.dataset.type;
      count.textContent = hi ? `${fmt(shown)} नतीजे` : `${fmt(shown)} results`;
      none.hidden = shown > 0;
    };
    q.addEventListener('input', () => {
      window.clearTimeout(t);
      t = window.setTimeout(run, 120);
    });
    for (const b of buttons) {
      b.addEventListener('click', () => {
        type = b.dataset.dirType ?? '';
        for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
        run();
      });
    }
    // "Browse by type" links in the hero: pick the type, then the link scrolls to the list.
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-pick]')) {
      a.addEventListener('click', () => buttons.find((b) => b.dataset.dirType === a.dataset.pick)?.click());
    }
    // Words typed before the script loaded still filter.
    if (q.value.trim()) run();
    root.dataset.ready = '';
  }
</script>
