---
/**
 * The right column of a place hero: short groups of live facts and nearby
 * places. A row is a line of text, or a name with a value on the right
 * (a distance, a count), optionally a link and a landmark mark.
 */
import { LANDMARK_GLYPH } from './glyphs';

/** `linkValue`: the value is what the link names ("Place: Sector 62"), so it carries the underline. */
export type FactRow = { text: string; value?: string; href?: string; glyph?: string; strong?: boolean; linkValue?: boolean };
type Props = { groups: { title: string; rows: FactRow[] }[] };
const groups = Astro.props.groups.filter((g) => g.rows.length);
---

{
  groups.map((g) => (
    <div class="pf">
      <p class="pf-title">{g.title}</p>
      <ul class="pf-rows">
        {g.rows.map((r) => {
          const inner = (
            <>
              {r.glyph && (
                <svg class="pf-glyph" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path fill-rule="evenodd" d={LANDMARK_GLYPH[r.glyph] ?? LANDMARK_GLYPH.commercial} />
                </svg>
              )}
              <span class:list={['pf-text', r.strong && 'is-strong', r.href && !r.linkValue && 'is-link']}>{r.text}</span>
              {r.value && <span class:list={['pf-value tabular', r.href && r.linkValue && 'is-link']}>{r.value}</span>}
            </>
          );
          return <li class:list={['pf-row', r.glyph && 'has-glyph', r.value && 'has-value']}>{r.href ? <a href={r.href}>{inner}</a> : inner}</li>;
        })}
      </ul>
    </div>
  ))
}

<style>
  .pf {
    display: grid;
    gap: 0.375rem;
  }

  .pf-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink-600);
  }

  .pf-rows {
    display: grid;
  }

  .pf-row > a,
  .pf-row:not(:has(> a)) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: baseline;
    column-gap: 0.625rem;
    padding: 0.125rem 0;
    color: var(--color-ink-800);
  }

  .pf-row.has-value > a,
  .pf-row.has-value:not(:has(> a)) {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .pf-row.has-glyph > a,
  .pf-row.has-glyph:not(:has(> a)) {
    grid-template-columns: 1.125rem minmax(0, 1fr) auto;
    align-items: center;
  }

  .pf-row > a {
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }

  /* A group with a link row: every row gets the link's 44 px, so the rows keep one rhythm. */
  .pf-rows:has(> .pf-row > a) > .pf-row:not(:has(> a)) {
    min-height: 44px;
    align-items: center;
  }

  .pf-row > a .is-link {
    text-decoration: underline;
    text-decoration-color: rgb(138 51 0 / 0.35);
    text-underline-offset: 3px;
  }

  .pf-row > a:hover {
    color: var(--color-kesar-700);
  }

  .pf-glyph {
    color: var(--color-kesar-700);
  }

  .pf-text.is-strong {
    font-weight: 700;
    color: var(--color-kesar-700);
  }

  .pf-value {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink-950);
    white-space: nowrap;
  }
</style>
