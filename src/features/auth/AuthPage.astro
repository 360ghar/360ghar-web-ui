---
/**
 * Shell for sign-in pages: the form island (client only, no SEO value) on a
 * paper sheet. The street diorama sits beside it on wide screens; on phones
 * and tablets it is a short band above, and the sheet crosses its lower edge.
 */
import Page from '@/layouts/Page.astro';
import Diorama from '@/features/home/diorama/Diorama.astro';
import AuthFlows, { type Mode } from './AuthFlows';

type Props = { mode: Mode };
const { mode } = Astro.props;
const locale = Astro.locals.locale;

/** Title and description per page and locale. Every sign-in page has its own pair. */
const META: Record<Mode, Record<'en' | 'hi', [string, string]>> = {
  login: { en: ['Sign in | 360Ghar', 'Sign in to 360Ghar with your mobile number, email or Google to see saved homes and visits.'], hi: ['साइन इन | 360Ghar', 'सेव किए घर और विज़िट देखने के लिए मोबाइल नंबर, ईमेल या Google से 360Ghar में साइन इन करें।'] },
  register: { en: ['Create an account | 360Ghar', 'Create a free 360Ghar account to save homes, book visits and post your property.'], hi: ['अकाउंट बनाएँ | 360Ghar', 'घर सेव करने, विज़िट बुक करने और प्रॉपर्टी पोस्ट करने के लिए मुफ़्त 360Ghar अकाउंट बनाएँ।'] },
  forgot: { en: ['Reset your password | 360Ghar', 'Enter your mobile number or email and 360Ghar sends you a code to reset your password.'], hi: ['पासवर्ड रीसेट करें | 360Ghar', 'अपना मोबाइल नंबर या ईमेल डालें, 360Ghar पासवर्ड रीसेट करने का कोड भेजेगा।'] },
  reset: { en: ['Choose a new password | 360Ghar', 'Set a new password for your 360Ghar account.'], hi: ['नया पासवर्ड चुनें | 360Ghar', 'अपने 360Ghar अकाउंट के लिए नया पासवर्ड सेट करें।'] },
  callback: { en: ['Signing in | 360Ghar', 'Finishing your sign-in to 360Ghar.'], hi: ['साइन इन हो रहा है | 360Ghar', '360Ghar में आपका साइन इन पूरा हो रहा है।'] },
  'add-phone': { en: ['Add your phone | 360Ghar', 'Add your mobile number so owners and your 360Ghar relationship manager can reach you about visits.'], hi: ['अपना फ़ोन जोड़ें | 360Ghar', 'अपना मोबाइल नंबर जोड़ें, ताकि मालिक और आपके 360Ghar रिलेशनशिप मैनेजर विज़िट के बारे में आपसे संपर्क कर सकें।'] },
  profile: { en: ['Complete your profile | 360Ghar', 'Add your name and details to finish your 360Ghar profile.'], hi: ['अपनी प्रोफ़ाइल पूरी करें | 360Ghar', 'अपनी 360Ghar प्रोफ़ाइल पूरी करने के लिए नाम और जानकारी जोड़ें।'] },
};
const [title, description] = META[mode][locale === 'hi' ? 'hi' : 'en'];
---

<Page title={title} description={description} noindex>
  <div class="auth-wrap">
    <div class="container-page auth-grid">
      <div class="auth-art" aria-hidden="true">
        <Diorama class="auth-diorama" label="" />
      </div>
      <div class="auth-sheet sheet">
        <AuthFlows client:only="react" mode={mode} locale={locale}>
          <div slot="fallback" class="auth-card" aria-busy="true">
            <span class="skeleton h-9 w-48"></span>
            <span class="skeleton mt-3 h-5 w-64"></span>
            <span class="skeleton mt-6 h-11 w-full"></span>
            <span class="skeleton mt-4 h-11 w-full"></span>
          </div>
        </AuthFlows>
      </div>
    </div>
  </div>
</Page>

<style>
  .auth-wrap {
    padding-block: 0 3rem;
  }

  .auth-grid {
    display: grid;
    align-items: stretch;
  }

  /* Phone and tablet: a band of the street, full bleed, under the header. */
  .auth-art {
    margin-inline: calc(50% - 50vw);
    height: clamp(8.5rem, 26vw, 13rem);
    overflow: hidden;
  }

  .auth-art :global(.auth-diorama) {
    height: 100%;
  }

  .auth-sheet {
    position: relative;
    z-index: 1;
    margin-top: -1.75rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
    max-width: 30rem;
    width: 100%;
    margin-inline: auto;
  }

  @media (min-width: 64rem) {
    .auth-wrap {
      padding-block: 1.5rem 3rem;
    }

    .auth-grid {
      grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
      gap: 2rem;
    }

    .auth-art {
      order: 2;
      margin-inline: 0;
      height: auto;
      border-radius: var(--radius-lg);
    }

    .auth-art :global(.auth-diorama) {
      min-height: 34rem;
    }

    .auth-sheet {
      margin-top: 0;
    }
  }

  .auth-sheet :global(.auth-title) {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }

  .auth-sheet :global(.auth-lead) {
    margin-top: 0.5rem;
    color: var(--color-ink-800);
  }

  .auth-sheet :global(.auth-change) {
    min-height: 44px;
    margin-left: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  /* Steps: plain text, the current one in ink, done ones with a tick. */
  .auth-sheet :global(.auth-steps) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.125rem;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }

  .auth-sheet :global(.auth-steps li) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .auth-sheet :global(.auth-steps li > span) {
    font-weight: 700;
  }

  .auth-sheet :global(.auth-steps [data-state='now']) {
    color: var(--color-ink-950);
    font-weight: 600;
  }

  .auth-sheet :global(.auth-steps [data-state='done']) {
    color: var(--color-leaf-700);
  }

  .auth-sheet :global(.auth-body) {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }

  .auth-sheet :global(.auth-or) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-ink-600);
    font-size: 0.875rem;
  }

  .auth-sheet :global(.auth-or)::before,
  .auth-sheet :global(.auth-or)::after {
    content: '';
    height: 1px;
    border-radius: 9999px;
    background: var(--color-ink-200);
  }

  /* Secondary actions under a form: stacked, text aligned with the fields. */
  .auth-sheet :global(.auth-more) {
    display: grid;
    justify-items: start;
    margin-inline-start: -1.125rem;
  }

  .auth-sheet :global(.auth-switch) {
    text-align: center;
    color: var(--color-ink-800);
  }

  .auth-sheet :global(.auth-last) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }

  .auth-sheet :global(.auth-last svg) {
    margin-top: 0.125rem;
    color: var(--color-kesar-700);
  }

  .auth-sheet :global(.auth-note) {
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-mist-50);
  }

  .auth-sheet :global(.auth-code) {
    font-size: 1.5rem;
    letter-spacing: 0.3em;
  }
</style>
