---
/**
 * Review-only switcher between the hero artwork studies. Fixed to the bottom
 * left, clear of the chat launcher at the bottom right.
 */
type Props = { here: 'a' | 'b' | 'c' };
const { here } = Astro.props;

const OPTIONS = [
  { id: 'a', label: 'A Street' },
  { id: 'b', label: 'B Skyline' },
  { id: 'c', label: 'C Homes' },
] as const;
---

<nav class="hero-switch" aria-label="Hero artwork">
  <span class="hero-switch-label">Art</span>
  {
    OPTIONS.map((o) => (
      <a href={`/lab/home-${o.id}`} aria-current={o.id === here ? 'page' : undefined}>
        {o.label}
      </a>
    ))
  }
</nav>

<style>
  /*
   * Top left, under the header. The bottom of every study holds the search
   * sheet, and a 44px control there would clip the card's bottom edge on a
   * phone; the top strip is empty sky in all three.
   */
  .hero-switch {
    position: fixed;
    z-index: 60;
    left: 1rem;
    top: calc(64px + 0.75rem);
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.25rem;
    border-radius: 9999px;
    background: rgb(15 29 25 / 0.92);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.16), 0 8px 20px -8px rgb(0 0 0 / 0.4);
  }

  .hero-switch-label {
    padding-inline: 0.625rem 0.375rem;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero-switch a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 0.75rem;
    border-radius: 9999px;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-switch a:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .hero-switch a[aria-current='page'] {
    background: var(--color-kesar-500);
    color: var(--color-ink-950);
  }
</style>
