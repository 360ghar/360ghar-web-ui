---
/**
 * Under the sentence: six finished sentences, each a link to a real listing
 * page. The words that change are marked the same way as the blanks above.
 */
import type { Locale } from '@/lib/i18n/locale';
import { localizer } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const L = localizer(locale);
const title = locale === 'hi' ? 'या इनमें से किसी से शुरू करें' : 'Or start from one of these';
/** [before, marked, after, href]. Same routes as the home page's explore list. */
const lines: [string, string, string, string][] = [
  ['Rent a ', '2 BHK flat', ' anywhere in Gurugram', '/gurgaon/rent/flats/2-bhk'],
  ['Rent a flat for up to ', '₹20,000 a month', '', '/gurgaon/rent/flats/budget/under-20k'],
  ['Find a ', 'PG', ' in Gurugram', '/gurgaon/pg/flats'],
  ['Buy a flat for up to ', '₹1 Cr', '', '/gurgaon/buy/flats/budget/under-1-crore'],
  ['Buy a ', 'builder floor', '', '/gurgaon/buy/builder-floor'],
  ['Buy a ', 'villa', ' in Gurugram', '/gurgaon/buy/villa'],
];
---

<section class="container-page se" aria-labelledby="se-title">
  <h2 id="se-title" class="se-title">{title}</h2>
  <ul class="se-list" role="list">
    {
      lines.map(([a, mark, b, href]) => (
        <li>
          <a href={L(href)}>
            <span>
              {a}
              <mark>{mark}</mark>
              {b}
            </span>
            <Icon name="arrow-up-right" size={20} class="se-arrow" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .se {
    margin-top: clamp(4rem, 8vw, 6rem);
  }

  .se-title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
  }

  .se-list {
    display: grid;
    gap: 0 3rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 56rem) {
    .se-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .se-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--color-ink-100);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 500;
    color: var(--color-ink-950);
    text-decoration: none;
    transition: background-color 140ms;
  }

  .se-list a:hover {
    background: var(--color-mist-50);
  }

  .se-list a:focus-visible {
    outline: 3px solid var(--color-kesar-700);
    outline-offset: 2px;
  }

  .se-list mark {
    padding: 0 0.1em;
    color: var(--color-kesar-800);
    background: linear-gradient(to bottom, transparent 58%, var(--color-kesar-100) 58%, var(--color-kesar-100) 92%, transparent 92%);
  }

  .se-list :global(.se-arrow) {
    flex: none;
    color: var(--color-kesar-700);
    transition: transform 160ms var(--ease-paper);
  }

  .se-list a:hover :global(.se-arrow) {
    transform: translate(3px, -3px);
  }
</style>
