---
/**
 * Under the map: the same homes as a table, one row per locality, so places
 * can be compared side by side. Then one line to the data hub.
 */
import type { ListingItem } from '@/features/search/listingItem';
import { groupHomes } from '@/features/search/mapLayout';
import { isPlaceholderPrice } from '@/features/search/prices';
import { askPrice, compactPrice, formatNum } from '@/lib/format';
import type { Locale } from '@/lib/i18n/locale';
import { localizer } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';

type Props = { locale: Locale; homes: ListingItem[]; stats: { circle: number | null; rera: number | null } };
const { locale, homes, stats } = Astro.props;
const L = localizer(locale);
const num = (n: number) => formatNum(n, locale);
const hi = locale === 'hi';
const c = hi
  ? { title: 'नक्शे के इलाके, आमने-सामने', place: 'इलाका', homes: 'घर', buy: 'खरीदने के लिए सबसे कम', stay: 'ठहरने के लिए सबसे कम', none: '–', open: 'घर देखें', hub: (a: string, b: string) => `नक्शे के नीचे का डेटा: ${a} सर्कल रेट और ${b} RERA प्रोजेक्ट`, hubLink: 'डेटा हब खोलें' }
  : { title: 'The places on the map, side by side', place: 'Locality', homes: 'Homes', buy: 'Lowest to buy', stay: 'Lowest to stay', none: '–', open: 'See homes', hub: (a: string, b: string) => `The data under the map: ${a} circle rates and ${b} RERA projects`, hubLink: 'Open the data hub' };

const low = (list: ListingItem[], purpose: string) => {
  const xs = list.filter((p) => p.purpose === purpose && !isPlaceholderPrice(p)).map(askPrice);
  return xs.length ? compactPrice(Math.min(...xs), locale) : null;
};
const rows = groupHomes(homes, askPrice)
  .sort((a, b) => b.homes.length - a.homes.length)
  .slice(0, 6)
  .map((g) => ({ name: g.name, n: g.homes.length, buy: low(g.homes, 'buy'), stay: low(g.homes, 'short_stay') }));
---

{
  rows.length ? (
    <section class="container-page mt" aria-labelledby="mt-title">
      <h2 id="mt-title" class="mt-title">{c.title}</h2>
      <div class="mt-scroll">
        <table class="mt-table">
          <thead>
            <tr>
              <th scope="col">{c.place}</th>
              <th scope="col" class="num">{c.homes}</th>
              <th scope="col" class="num">{c.buy}</th>
              <th scope="col" class="num">{c.stay}</th>
              <th scope="col"><span class="visually-hidden">{c.open}</span></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.name}</th>
                <td class="num tabular">{num(r.n)}</td>
                <td class="num tabular">{r.buy ?? c.none}</td>
                <td class="num tabular">{r.stay ? `${r.stay}${hi ? '/रात' : '/night'}` : c.none}</td>
                <td class="go">
                  <a class="link" href={L(`/properties?locality=${encodeURIComponent(r.name)}`)}>
                    {c.open}
                    <span class="visually-hidden">: {r.name}</span>
                    <Icon name="arrow-up-right" size={16} class="arrow" />
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {stats.circle && stats.rera ? (
        <p class="mt-hub">
          {c.hub(num(stats.circle), num(stats.rera))}.{' '}
          <a class="link" href={L('/circle-rates')}>
            {c.hubLink}
            <Icon name="arrow-up-right" size={16} class="arrow" />
          </a>
        </p>
      ) : null}
    </section>
  ) : null
}

<style>
  .mt {
    min-width: 0;
    margin-top: clamp(4rem, 8vw, 6rem);
  }

  .mt-title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
  }

  /* Positioned, so the hidden labels in the rows stay inside the scroll box. */
  .mt-scroll {
    position: relative;
    margin-top: 1.5rem;
    overflow-x: auto;
  }

  .mt-table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
  }

  .mt-table th,
  .mt-table td {
    padding: 0.85rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-ink-100);
  }

  .mt-table thead th {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-600);
  }

  .mt-table tbody th {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .mt-table .num {
    text-align: right;
  }

  .mt-table .go {
    text-align: right;
    white-space: nowrap;
  }

  .mt-table tbody tr:hover {
    background: var(--color-mist-50);
  }

  .mt-hub {
    margin-top: 1.5rem;
    color: var(--color-ink-600);
  }
</style>
