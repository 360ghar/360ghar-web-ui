---
import type { Locale } from '@/lib/i18n/locale';
import DataHubHold from './DataHubHold.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<DataHubHold
  locale={locale}
  path="/bank-auctions"
  en={{
    title: 'Bank auction listings under review | 360Ghar',
    description: 'Auction listings are withheld while source records, reuse terms and update checks are reviewed.',
    heading: 'Bank auction listings under review',
    crumb: 'Bank auctions',
    lead: 'Auction listings are not shown at this time.',
    notice: 'We are reviewing source records, reuse terms and update checks before showing auction listings.',
  }}
  hi={{
    title: 'बैंक नीलामी लिस्टिंग समीक्षा के अधीन | 360Ghar',
    description: 'स्रोत रिकॉर्ड, उपयोग की शर्तों और अपडेट जाँच की समीक्षा तक नीलामी लिस्टिंग रोकी गई हैं।',
    heading: 'बैंक नीलामी लिस्टिंग समीक्षा के अधीन',
    crumb: 'बैंक नीलामी',
    lead: 'नीलामी लिस्टिंग अभी नहीं दिखाई जा रही हैं।',
    notice: 'नीलामी लिस्टिंग दिखाने से पहले हम स्रोत रिकॉर्ड, उपयोग की शर्तों और अपडेट जाँच की समीक्षा कर रहे हैं।',
  }}
/>
