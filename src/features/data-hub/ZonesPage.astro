---
import type { Locale } from '@/lib/i18n/locale';
import DataHubHold from './DataHubHold.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<DataHubHold
  locale={locale}
  path="/zone-checker"
  en={{
    title: 'Gurugram zoning data under review | 360Ghar',
    description: 'Zoning values are withheld while source records, effective dates and verification evidence are reviewed.',
    heading: 'Zoning data under review',
    crumb: 'Zoning data',
    lead: 'Zoning values are not shown at this time.',
    notice: 'We are reviewing the source records, effective dates and verification evidence before showing zoning values.',
  }}
  hi={{
    title: 'गुरुग्राम ज़ोनिंग डेटा समीक्षा के अधीन | 360Ghar',
    description: 'स्रोत रिकॉर्ड, प्रभावी तारीखों और सत्यापन साक्ष्य की समीक्षा तक ज़ोनिंग के आंकड़े रोके गए हैं।',
    heading: 'ज़ोनिंग डेटा समीक्षा के अधीन',
    crumb: 'ज़ोनिंग डेटा',
    lead: 'ज़ोनिंग के आंकड़े अभी नहीं दिखाए जा रहे हैं।',
    notice: 'ज़ोनिंग के आंकड़े दिखाने से पहले हम स्रोत रिकॉर्ड, प्रभावी तारीखों और सत्यापन साक्ष्य की समीक्षा कर रहे हैं।',
  }}
/>
