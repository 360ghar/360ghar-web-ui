---
/** /verify-ownership: Jamabandi record lookup with clear legal limits. */
import { getT } from '@/i18n';
import { TEHSILS } from './content';
import DataHubPage from './DataHubPage.astro';
import VerifyOwnership from './VerifyOwnership';

const locale = Astro.locals.locale;
const tt = getT(locale);
const hi = locale === 'hi';
const plain = (html: string) => html.replace(/<[^>]+>/g, '');
---

<DataHubPage
  art="verifyOwnership"
  title={tt('seo:verifyOwnership.title')}
  description={tt('seo:verifyOwnership.description')}
  keywords="Haryana Jamabandi record lookup, land records Haryana, Khasra number lookup"
  path="/verify-ownership"
  heading={hi ? 'हरियाणा जमाबंदी रिकॉर्ड खोजें' : 'Haryana Jamabandi record lookup'}
  lead={tt('data-hub:verifyOwnership.description')}
  crumbs={[{ name: hi ? 'जमाबंदी रिकॉर्ड खोज' : 'Jamabandi record lookup', path: '/verify-ownership' }]}
>
  <p slot="head" class="dh-meta">{plain(tt('data-hub:verifyOwnership.important'))}</p>

  <div class="dh-split">
    <VerifyOwnership client:load locale={locale} tehsils={TEHSILS} />
    <section class="dh-prose mt-0" aria-labelledby="vo-about">
      <h2 id="vo-about">{tt('data-hub:verifyOwnership.aboutJamabandi.title')}</h2>
      <p>{tt('data-hub:verifyOwnership.aboutJamabandi.description')}</p>
      <ul>{[0, 1, 2, 3].map((i) => <li>{tt(`data-hub:verifyOwnership.aboutJamabandi.tips.${i}`)}</li>)}</ul>
      <p>{plain(tt('data-hub:verifyOwnership.dataSourced'))}</p>
    </section>
  </div>
</DataHubPage>
