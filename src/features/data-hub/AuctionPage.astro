---
import type { Locale } from '@/lib/i18n/locale';
import DataHubHold from './DataHubHold.astro';

type Props = { locale: Locale; path: string };
const { locale, path } = Astro.props;
---

<DataHubHold
  locale={locale}
  path={path}
  en={{
    title: 'Auction record under review | 360Ghar',
    description: 'This auction record is withheld while its source and current status are reviewed.',
    heading: 'Auction record under review',
    crumb: 'Auction record',
    lead: 'Auction details are not shown at this time.',
    notice: 'We are reviewing the source record and current status before showing auction details.',
  }}
  hi={{
    title: 'नीलामी रिकॉर्ड समीक्षा के अधीन | 360Ghar',
    description: 'स्रोत और मौजूदा स्थिति की समीक्षा तक यह नीलामी रिकॉर्ड रोका गया है।',
    heading: 'नीलामी रिकॉर्ड समीक्षा के अधीन',
    crumb: 'नीलामी रिकॉर्ड',
    lead: 'नीलामी का विवरण अभी नहीं दिखाया जा रहा है।',
    notice: 'नीलामी का विवरण दिखाने से पहले हम स्रोत रिकॉर्ड और मौजूदा स्थिति की समीक्षा कर रहे हैं।',
  }}
/>
