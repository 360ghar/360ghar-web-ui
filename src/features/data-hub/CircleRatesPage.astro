---
/** /circle-rates: unavailable until a dated official schedule is verified. */
import type { Locale } from '@/lib/i18n/locale';
import CircleRates from './CircleRates';
import DataHubPage from './DataHubPage.astro';
import { hubName } from './pages';
import { text } from './text';

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = text(locale);
---

<DataHubPage
  art="circleRates"
  title={t.crUnavailableTitle}
  description={t.crUnavailableBody}
  path="/circle-rates"
  noindex
  heading={t.crUnavailableTitle}
  crumbs={[{ name: hubName('circleRates', locale), path: '/circle-rates' }]}
>
  <CircleRates locale={locale} />
</DataHubPage>
