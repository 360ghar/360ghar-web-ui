---
import type { Locale } from '@/lib/i18n/locale';
import DataHubHold from './DataHubHold.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<DataHubHold
  locale={locale}
  path="/regulatory-updates"
  en={{
    title: 'Haryana regulatory records under review | 360Ghar',
    description: 'Notification records are withheld while official sources and checked dates are reviewed.',
    heading: 'Regulatory records under review',
    crumb: 'Regulatory records',
    lead: 'Notification records are not shown at this time.',
    notice: 'We are reviewing the official source and checked date for each record before publishing it.',
  }}
  hi={{
    title: 'हरियाणा नियामक रिकॉर्ड समीक्षा के अधीन | 360Ghar',
    description: 'आधिकारिक स्रोतों और जाँच की तारीखों की समीक्षा तक अधिसूचना रिकॉर्ड रोके गए हैं।',
    heading: 'नियामक रिकॉर्ड समीक्षा के अधीन',
    crumb: 'नियामक रिकॉर्ड',
    lead: 'अधिसूचना रिकॉर्ड अभी नहीं दिखाए जा रहे हैं।',
    notice: 'हर रिकॉर्ड प्रकाशित करने से पहले हम उसके आधिकारिक स्रोत और जाँच की तारीख की समीक्षा कर रहे हैं।',
  }}
/>
