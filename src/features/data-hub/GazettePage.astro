---
/** /regulatory-updates: gazette notices by type, page 1 on the server. */
import { getT } from '@/i18n';
import type { GazettePage } from '@/features/data-hub/api';
import type { ApiError } from '@/lib/api/errors';
import type { Locale } from '@/lib/i18n/locale';
import { canonicalFor } from '@/lib/seo/site';
import { FAQ } from './content';
import DataHubPage from './DataHubPage.astro';
import { hubName } from './pages';
import GazetteNotices from './Gazette';
import type { GazetteFilters } from './params';
import { text } from './text';

type Props = { locale: Locale; filters: GazetteFilters; page: GazettePage | null; error: ApiError | null };
const { locale, filters, page, error } = Astro.props;
const t = text(locale);
const tt = getT(locale);
---

<DataHubPage
  art="gazette"
  title={tt('seo:regulatoryUpdates.title')}
  description={tt('seo:regulatoryUpdates.description')}
  keywords="Haryana Gazette notifications, Gurugram regulatory updates, land acquisition notices, circle rate revision, CLU change Gurgaon, HRERA policy update, 360Ghar data hub"
  path="/regulatory-updates"
  heading={t.gzH1}
  lead={tt('data-hub:regulatoryUpdates.description')}
  crumbs={[{ name: hubName('gazette', locale), path: '/regulatory-updates' }]}
  faqs={FAQ.gazette}
  jsonLd={[
    {
      '@type': 'CollectionPage',
      name: 'Regulatory Updates, Haryana Gazette',
      description: 'Official notifications from the Haryana Government affecting real estate in Gurugram.',
      url: canonicalFor('/regulatory-updates', locale),
    },
  ]}
  related={['zones', 'circleRates', 'rera', 'builders']}
>
  <div class="max-w-[56rem]">
    <GazetteNotices client:load locale={locale} initialFilters={filters} initialPage={error ? null : page} />
  </div>
</DataHubPage>
