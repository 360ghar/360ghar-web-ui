---
/** /builder-reputation-score: the old static 2026 guide (8 builders), data as it was. */
import { absoluteUrl } from '@/lib/seo/site';
import { BUILDERS, FAQ } from './content';
import DataHubPage from './DataHubPage.astro';
import { fmtDate, scoreBand } from './format';
import { ScoreRing } from './ScoreRing';
import { text } from './text';

const locale = Astro.locals.locale;
const t = text(locale);
const hi = locale === 'hi';
const MODIFIED = '2026-01-01';
const L = hi
  ? { h1: 'बिल्डर स्कोर गाइड 2026', lead: 'गुरुग्राम के आठ बड़े बिल्डर, 360Ghar की जनवरी 2026 की अपनी रिसर्च के स्कोर के साथ। नीचे दिए स्कोर, प्रोजेक्ट और शिकायत के आँकड़े उसी रिसर्च के हैं, रजिस्टर के मौजूदा आँकड़े नहीं। रजिस्टर से बने आज के स्कोर के लिए बिल्डर प्रतिष्ठा निर्देशिका देखें।', projects: 'RERA प्रोजेक्ट', complaints: 'शिकायतें', delivery: 'डिलीवरी', areas: 'इलाके', crumb: 'बिल्डर गाइड 2026' }
  : { h1: 'Builder score guide 2026', lead: 'Eight large Gurugram builders, with the scores from 360Ghar\u2019s own January 2026 research. The score, project and complaint figures below are that research\u2019s, not the register\u2019s current numbers. For the score the site computes today from the registers, open the builder reputation directory.', projects: 'RERA projects', complaints: 'Complaints', delivery: 'Delivery', areas: 'Areas', crumb: 'Builder guide 2026' };
---

<DataHubPage
  art="builderScore"
  title="Builder Score Guide 2026 | 360Ghar Research | 360Ghar"
  description="360Ghar's own January 2026 research on eight large Gurugram builders. The scores are editorial estimates, not the register's current figures; the builder reputation directory carries those."
  keywords="builder score guide Gurugram, reliable builders Gurgaon 2026, best developers Gurugram, DLF, M3M"
  path="/builder-reputation-score"
  heading={L.h1}
  lead={L.lead}
  crumbs={[{ name: L.crumb, path: '/builder-reputation-score' }]}
  faqs={FAQ.builderScore}
  jsonLd={[
    {
      '@type': 'Dataset',
      name: 'Builder Score Guide, Gurugram 2026 (360Ghar research)',
      description: '360Ghar editorial research from January 2026 on eight large Gurugram developers. These scores, project counts and complaint counts are the guide\u2019s own estimates; they are not the figures the 360Ghar builder reputation directory computes from the RERA registers.',
      url: absoluteUrl('/builder-reputation-score'),
      creator: { '@type': 'Organization', name: '360Ghar', url: 'https://360ghar.com' },
      dateModified: MODIFIED,
      license: 'https://creativecommons.org/licenses/by/4.0/',
      spatialCoverage: { '@type': 'Place', name: 'Gurugram, Haryana, India' },
      keywords: ['builder score guide Gurugram', 'Gurgaon developers 2026', 'reliable builders Gurgaon'],
    },
  ]}
  related={['builders', 'rera', 'tenant', 'bestSectors']}
>
  <p slot="head" class="dh-meta">{t.updated(fmtDate(MODIFIED, locale, 'long') ?? MODIFIED)} {t.bands.good}. {t.bands.average}. {t.bands.poor}.</p>

  <ul class="dh-cards">
    {
      BUILDERS.map((b) => (
        <li>
          <article class="sheet dh-card gap-3">
            <div class="flex items-center gap-4">
              <ScoreRing score={b.reraScore} size={84} label={`${t.bdScore}: ${b.reraScore} ${t.bdOutOf}`} />
              <div>
                <h2 class="dh-row-title text-xl">{b.name}</h2>
                <p class:list={['dh-status mt-1', { good: 'is-good', average: 'is-wait', poor: 'is-bad' }[scoreBand(b.reraScore)]]}>{t.bandShort[scoreBand(b.reraScore)]}</p>
              </div>
            </div>
            <dl class="dh-facts mt-0">
              <div>
                <dt>{L.projects}</dt>
                <dd>{b.projects}</dd>
              </div>
              <div>
                <dt>{L.complaints}</dt>
                <dd>{b.complaints}</dd>
              </div>
              <div>
                <dt>{L.delivery}</dt>
                <dd>{b.delivery}</dd>
              </div>
            </dl>
            <p class="text-ink-800">{b.note}</p>
            <p class="dh-row-sub">
              <span class="font-semibold text-ink-800">{L.areas}:</span> {b.areas.join(' · ')}
            </p>
          </article>
        </li>
      ))
    }
  </ul>
  <p class="dh-meta mt-6">{t.disclaimer}</p>
</DataHubPage>
