---
import DataHubPage from './DataHubPage.astro';

const hi = Astro.locals.locale === 'hi';
const copy = hi
  ? {
      title: 'गुरुग्राम किराया रिसर्च समीक्षा के अधीन | 360Ghar',
      description: 'किराया और मांग संबंधी रिसर्च स्रोतों की समीक्षा तक रोकी गई है।',
      heading: 'किरायेदार मांग रिसर्च समीक्षा के अधीन',
      crumb: 'किरायेदार मांग रिसर्च',
      notice: 'मांग स्कोर, किराया, रिक्तता और रुझान के आंकड़े स्रोतों और तरीकों की समीक्षा तक प्रकाशित नहीं हैं।',
    }
  : {
      title: 'Gurugram rental research under review | 360Ghar',
      description: 'Rental and demand research is held while its sources are reviewed.',
      heading: 'Tenant-demand research under review',
      crumb: 'Tenant-demand research',
      notice: 'Demand scores, rents, vacancy and trend figures are withheld while sources and methods are reviewed.',
    };
---

<DataHubPage
  title={copy.title}
  description={copy.description}
  path="/tenant-demand-heatmap"
  noindex
  heading={copy.heading}
  lead={copy.notice}
  crumbs={[{ name: copy.crumb, path: '/tenant-demand-heatmap' }]}
>
  <p>{copy.notice}</p>
</DataHubPage>
