---
import type { Locale } from '@/lib/i18n/locale';
import DataHubHold from './DataHubHold.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<DataHubHold
  locale={locale}
  path="/auction-sources"
  en={{
    title: 'Auction source directory under review | 360Ghar',
    description: 'Portal links are withheld while attribution, reuse terms and current URLs are reviewed.',
    heading: 'Auction source directory under review',
    crumb: 'Auction sources',
    lead: 'Portal links are not shown at this time.',
    notice: 'We are reviewing source attribution, reuse terms and current URLs before publishing the directory.',
  }}
  hi={{
    title: 'नीलामी स्रोत निर्देशिका समीक्षा के अधीन | 360Ghar',
    description: 'श्रेय, उपयोग की शर्तों और मौजूदा URL की समीक्षा तक पोर्टल लिंक रोके गए हैं।',
    heading: 'नीलामी स्रोत निर्देशिका समीक्षा के अधीन',
    crumb: 'नीलामी स्रोत',
    lead: 'पोर्टल लिंक अभी नहीं दिखाए जा रहे हैं।',
    notice: 'निर्देशिका प्रकाशित करने से पहले हम स्रोत श्रेय, उपयोग की शर्तों और मौजूदा URL की समीक्षा कर रहे हैं।',
  }}
/>
