---
/** /stamp-duty-calculator: unavailable until an official schedule is verified. */
import type { Locale } from '@/lib/i18n/locale';
import DataHubPage from './DataHubPage.astro';
import { hubName } from './pages';
import StampDuty from './StampDuty';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy =
  locale === 'hi'
    ? {
        title: 'स्टैंप ड्यूटी का अनुमान उपलब्ध नहीं',
        description: 'आधिकारिक दर-सूची और लागू होने की तारीख सत्यापित होने तक यह जानकारी उपलब्ध नहीं है।',
        keywords: 'स्टैंप ड्यूटी जानकारी',
      }
    : {
        title: 'Stamp duty estimate unavailable',
        description: 'This information is unavailable until an official schedule and effective date are verified.',
        keywords: 'stamp duty information',
      };
---

<DataHubPage
  art="stampDuty"
  title={copy.title}
  description={copy.description}
  keywords={copy.keywords}
  path="/stamp-duty-calculator"
  noindex
  heading={copy.title}
  lead={copy.description}
  crumbs={[{ name: hubName('stampDuty', locale), path: '/stamp-duty-calculator' }]}
  related={['circleRates', 'zones', 'ownership', 'auctions']}
>
  <StampDuty client:load locale={locale} />
</DataHubPage>
