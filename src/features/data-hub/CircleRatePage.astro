---
/** /circle-rate/:slug: canonical detail route, withheld until a dated official schedule is verified. */
import type { Locale } from '@/lib/i18n/locale';
import CircleRates from './CircleRates';
import DataHubPage from './DataHubPage.astro';
import { hubName } from './pages';
import { text } from './text';

type Props = { locale: Locale; slug: string };
const { locale, slug } = Astro.props;
const t = text(locale);
---

<DataHubPage
  art="circleRates"
  title={t.crUnavailableTitle}
  description={t.crUnavailableBody}
  path={`/circle-rate/${slug}`}
  noindex
  heading={t.crUnavailableTitle}
  crumbs={[
    { name: hubName('circleRates', locale), path: '/circle-rates' },
    { name: t.crUnavailableTitle },
  ]}
>
  <CircleRates locale={locale} />
</DataHubPage>
