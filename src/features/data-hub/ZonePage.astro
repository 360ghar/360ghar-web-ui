---
import type { Locale } from '@/lib/i18n/locale';
import DataHubHold from './DataHubHold.astro';

type Props = { locale: Locale; path: string };
const { locale, path } = Astro.props;
---

<DataHubHold
  locale={locale}
  path={path}
  en={{
    title: 'Zoning record under review | 360Ghar',
    description: 'This zoning record is withheld while its source, effective date and verification evidence are reviewed.',
    heading: 'Zoning record under review',
    crumb: 'Zoning record',
    lead: 'Zoning values are not shown at this time.',
    notice: 'We are reviewing the source record, effective date and verification evidence before showing zoning values.',
  }}
  hi={{
    title: 'ज़ोनिंग रिकॉर्ड समीक्षा के अधीन | 360Ghar',
    description: 'स्रोत, प्रभावी तारीख और सत्यापन साक्ष्य की समीक्षा तक यह ज़ोनिंग रिकॉर्ड रोका गया है।',
    heading: 'ज़ोनिंग रिकॉर्ड समीक्षा के अधीन',
    crumb: 'ज़ोनिंग रिकॉर्ड',
    lead: 'ज़ोनिंग के आंकड़े अभी नहीं दिखाए जा रहे हैं।',
    notice: 'ज़ोनिंग के आंकड़े दिखाने से पहले हम स्रोत रिकॉर्ड, प्रभावी तारीख और सत्यापन साक्ष्य की समीक्षा कर रहे हैं।',
  }}
/>
