---
/**
 * The app. A mist sheet: text and the official store badges (src/lib/apps.ts) on the left, a
 * paper-cut phone on the right that rises above the sheet's top edge. On a
 * wide screen with a mouse there is a QR code of the Google Play link. No download
 * counts, ratings or version numbers: the old ones were not sourced. The one
 * motion is the phone easing up as it enters the screen (scroll-linked CSS;
 * it sits in its final place without support and with reduced motion).
 */
import type { Locale } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';
import StoreBadges from '@/ui/StoreBadges.astro';
import { MORE } from '../more';
import { PLAY_QR } from '../qr';
import Vignette from '../vignettes/Vignette.astro';

type Props = { locale: Locale; class?: string };
const { locale, class: className } = Astro.props;
const c = MORE[locale].app;
const pad = 2;
---

<section class:list={['app container-page', className]} aria-labelledby="home-app">
  <div class="app-sheet">
    <div class="app-copy">
      <h2 id="home-app" class="app-title">{c.title}</h2>
      <p class="app-lead">{c.lead}</p>
      <ul class="app-features" role="list">
        {
          c.features.map((f) => (
            <li>
              <Icon name="check" size={20} />
              {f}
            </li>
          ))
        }
      </ul>
      <div class="app-actions">
        <StoreBadges app="ghar360" />
        <figure class="app-qr">
          <svg
            viewBox={`${-pad} ${-pad} ${PLAY_QR.size + pad * 2} ${PLAY_QR.size + pad * 2}`}
            role="img"
            aria-label={c.qr}
            shape-rendering="crispEdges"
          >
            <rect x={-pad} y={-pad} width={PLAY_QR.size + pad * 2} height={PLAY_QR.size + pad * 2} fill="#fff"></rect>
            <path d={PLAY_QR.path} fill="var(--color-ink-950)"></path>
          </svg>
          <figcaption>{c.qrNote}</figcaption>
        </figure>
      </div>
    </div>
    <div class="app-art">
      <Vignette name="app" bare class="app-phone" />
    </div>
  </div>
</section>

<style>
  .app {
    margin-top: clamp(4.5rem, 9vw, 7rem);
  }

  .app-sheet {
    display: grid;
    gap: 1.5rem 2rem;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--color-mist-50);
    border-radius: var(--radius-xl);
  }

  @media (min-width: 56rem) {
    .app-sheet {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .app-title {
    max-width: 18ch;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    line-height: 1.1;
  }

  .app-lead {
    margin-top: 0.75rem;
    max-width: 44ch;
    color: var(--color-ink-800);
  }

  .app-features {
    display: grid;
    gap: 0.5rem 2rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 40rem) {
    .app-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .app-features li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem;
    color: var(--color-ink-800);
  }

  .app-features :global(svg) {
    margin-top: 0.15rem;
    color: var(--color-leaf-700);
  }

  .app-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 1.75rem;
  }

  /* A QR code helps only when the phone is not the screen: wide, with a mouse. */
  .app-qr {
    display: none;
    margin: 0;
    width: 7.5rem;
    text-align: center;
  }

  @media (min-width: 64rem) and (hover: hover) {
    .app-qr {
      display: block;
    }
  }

  .app-qr svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 1px rgb(var(--tint) / 0.08), 0 2px 6px -2px rgb(var(--tint) / 0.16);
  }

  .app-qr figcaption {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }

  .app-art {
    justify-self: center;
    width: min(100%, 20rem);
  }

  @media (min-width: 56rem) {
    /* The phone rises 3 rem above the sheet's top edge (the sheet pads 3 rem at most, so -6 rem). */
    .app-art {
      align-self: start;
      width: min(100%, 26rem);
      margin-top: -6rem;
    }

    /* The drawing starts at its phone (no dead band on a phone). Here the phone keeps its old spot: 28 of 360 units of the art's width, as a margin on the image. */
    .app-art :global(.app-phone) {
      margin-top: 7.778%;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .app-art :global(.app-phone) {
        animation: app-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes app-rise {
    from {
      translate: 0 2.5rem;
    }

    to {
      translate: 0 0;
    }
  }
</style>
