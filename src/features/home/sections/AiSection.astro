---
/**
 * The AI assistant. Left: the point, the real MCP server address with a copy
 * button, and the link to /ai-agent. Right: four things to ask, as plain
 * slips. They are prompts the tools can answer (tools are listed in
 * features/content/ai/mcp.ts). There are no assistant replies and no counts:
 * the old page showed invented results and stats.
 */
import CopyButton from '@/features/content/shared/CopyButton';
import { MCP_URL } from '@/features/content/ai/mcp';
import type { Locale } from '@/lib/i18n/locale';
import { localizer } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';
import { MORE } from '../more';

type Props = { locale: Locale; class?: string };
const { locale, class: className } = Astro.props;
const c = MORE[locale].ai;
const L = localizer(locale);
---

<section class:list={['ai container-page', className]} aria-labelledby="home-ai">
  <div class="ai-copy">
    <h2 id="home-ai" class="ai-title">{c.title}</h2>
    <p class="ai-lead">{c.lead}</p>
    <div class="ai-server">
      <p class="ai-server-label">{c.server}</p>
      <code class="ai-url">{MCP_URL}</code>
      <div class="ai-server-actions">
        <CopyButton client:visible locale={locale} text={MCP_URL} label={c.copy} done={c.copied} />
        <a class="link" href={L('/ai-agent')}>
          {c.more}
          <Icon name="arrow-up-right" size={16} class="arrow" />
        </a>
      </div>
    </div>
  </div>
  <ul class="ai-prompts" role="list" aria-label={c.list}>
    {
      c.prompts.map((p) => (
        <li>
          <strong class="ai-who">{p.who}</strong>
          <span class="ai-say">{p.say}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .ai {
    display: grid;
    gap: 2rem 3rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  @media (min-width: 56rem) {
    .ai {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
  }

  .ai-title {
    max-width: 20ch;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    line-height: 1.1;
  }

  .ai-lead {
    margin-top: 0.75rem;
    max-width: 46ch;
    color: var(--color-ink-800);
  }

  .ai-server {
    display: grid;
    justify-items: start;
    gap: 0.25rem;
    margin-top: 1.5rem;
  }

  .ai-server-label {
    font-size: 0.9375rem;
    color: var(--color-ink-600);
  }

  /* An address is data, so it gets a mono face; nothing else on the page does. */
  .ai-url {
    max-width: 100%;
    padding: 0.5rem 0.75rem;
    overflow-wrap: anywhere;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.9375rem;
    color: var(--color-ink-950);
    background: var(--color-mist-100);
    border-radius: var(--radius-sm);
  }

  .ai-server-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
  }

  .ai-prompts {
    display: grid;
    gap: 0.75rem;
  }

  .ai-prompts li {
    display: grid;
    gap: 0.125rem;
    padding: 0.875rem 1.125rem;
    background: var(--color-mist-100);
    border-radius: var(--radius-md);
  }

  /* From tablet width, every second slip steps in, like a two-sided thread. */
  @media (min-width: 40rem) {
    .ai-prompts li {
      max-width: 34rem;
    }

    .ai-prompts li:nth-child(even) {
      margin-inline-start: clamp(1rem, 6vw, 3.5rem);
      background: var(--color-mist-200);
    }
  }

  .ai-who {
    font-size: 0.9375rem;
    color: var(--color-ink-800);
  }

  .ai-say {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.3;
    color: var(--color-ink-950);
  }
</style>
