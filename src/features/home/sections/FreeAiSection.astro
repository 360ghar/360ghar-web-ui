---
/**
 * Home property tools. The before/after is labeled as a design example in the
 * visible copy; the slider only compares those two images. The links below
 * point to the tools without promising access terms or typical results.
 */
import type { Locale } from '@/lib/i18n/locale';
import { localizer } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';

type Props = { locale: Locale; class?: string };
const { locale, class: className } = Astro.props;
const L = localizer(locale);

const COPY = {
  en: {
    title: 'Explore property tools',
    lead: 'Check each tool’s current inputs, limits and access terms before use.',
    by: 'Results can be incomplete and are not professional advice.',
    before: 'Starting room',
    after: 'Design example',
    slider: 'Compare the starting room with the design example',
    tools: [
      { name: 'AI Design Studio', note: 'Explore room-design concepts from a photo or prompt. Review input limits before uploading.', cta: 'Open the tool', href: '/ai-design-studio' },
      { name: 'Vastu checker', note: 'Compare a floor plan with the tool’s Vastu rules. Results are not structural or safety advice.', cta: 'Open the tool', href: '/vastu-checker' },
      { name: 'Ask 360Ghar', note: 'Ask about property search. A response does not verify property details or availability; confirm both with the listing party.', cta: 'Open chat', chat: true },
    ],
  },
  hi: {
    title: 'प्रॉपर्टी टूल देखें',
    lead: 'हर टूल के इनपुट, सीमाएँ और उपयोग की शर्तें चलाने से पहले देखें।',
    by: 'नतीजे अधूरे हो सकते हैं; ये पेशेवर सलाह नहीं हैं।',
    before: 'शुरुआती कमरा',
    after: 'डिज़ाइन उदाहरण',
    slider: 'शुरुआती कमरे और डिज़ाइन उदाहरण की तुलना करें',
    tools: [
      { name: 'AI डिज़ाइन स्टूडियो', note: 'फ़ोटो या प्रॉम्प्ट से कमरे के डिज़ाइन विकल्प देखें। अपलोड से पहले इनपुट की सीमाएँ पढ़ें।', cta: 'टूल खोलें', href: '/ai-design-studio' },
      { name: 'वास्तु चेकर', note: 'टूल के वास्तु नियमों से फ़्लोर प्लान देखें। नतीजे संरचना या सुरक्षा की सलाह नहीं हैं।', cta: 'टूल खोलें', href: '/vastu-checker' },
      { name: '360Ghar से पूछें', note: 'प्रॉपर्टी खोज के बारे में पूछें। जवाब प्रॉपर्टी या उपलब्धता की पुष्टि नहीं करता; लिस्टिंग देने वाले से जाँचें।', cta: 'चैट खोलें', chat: true },
    ],
  },
}[locale];
---

<section class:list={['fai container-page', className]} aria-labelledby="home-fai">
  <div class="fai-head">
    <h2 id="home-fai" class="fai-title">{COPY.title}</h2>
    <p class="fai-lead">
      <strong>{COPY.lead}</strong>
      {' '}{COPY.by}
    </p>
  </div>

  <figure class="fai-stage" style="--cmp: 50%">
    <img
      src="/images/ai/room-before-1920.webp"
      srcset="/images/ai/room-before-960.webp 960w, /images/ai/room-before-1920.webp 1920w"
      sizes="(min-width: 80rem) 76rem, 100vw"
      width="1920"
      height="823"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <img
      class="fai-after"
      src="/images/ai/room-after-1920.webp"
      srcset="/images/ai/room-after-960.webp 960w, /images/ai/room-after-1920.webp 1920w"
      sizes="(min-width: 80rem) 76rem, 100vw"
      width="1920"
      height="823"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="fai-divider" aria-hidden="true"><span class="fai-grip"></span></span>
    <figcaption class="fai-labels" aria-hidden="true">
      <span>{COPY.before}</span>
      <span>{COPY.after}</span>
    </figcaption>
    <input class="fai-range" type="range" min="0" max="100" value="50" aria-label={COPY.slider} aria-valuetext="50%" data-fai-range />
  </figure>

  <ul class="fai-tools" role="list">
    {
      COPY.tools.map((tool) => (
        <li>
          <h3 class="fai-name">{tool.name}</h3>
          <p class="fai-note">{tool.note}</p>
          {tool.chat ? (
            <button type="button" class="fai-go" data-fai-chat>
              {tool.cta}
              <Icon name="arrow-up-right" size={18} class="arrow" />
            </button>
          ) : (
            <a class="fai-go" href={L(tool.href!)}>
              {tool.cta}
              <Icon name="arrow-up-right" size={18} class="arrow" />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<script>
  for (const range of document.querySelectorAll<HTMLInputElement>('[data-fai-range]')) {
    const stage = range.closest<HTMLElement>('.fai-stage');
    range.addEventListener('input', () => {
      stage?.style.setProperty('--cmp', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${range.value}%`);
    });
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-fai-chat]')) {
    btn.addEventListener('click', () => document.querySelector<HTMLElement>('[data-chat-launcher]')?.click());
  }
</script>

<style>
  .fai {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .fai-head {
    display: grid;
    gap: 0.75rem 3rem;
  }

  /* Same three columns as the tool list, so the lead starts on the third tool's edge. */
  @media (min-width: 48rem) {
    .fai-head {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2.5rem;
      align-items: end;
    }

    .fai-title {
      grid-column: span 2;
    }
  }

  .fai-title {
    max-width: 24ch;
    font-size: clamp(1.5rem, 1.1rem + 2.4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .fai-lead {
    max-width: 40ch;
    color: var(--color-ink-800);
  }

  .fai-lead strong {
    color: var(--color-ink-950);
  }

  /* The photo pair. The after image is clipped from the left by --cmp. */
  .fai-stage {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 1920 / 823;
    border-radius: var(--radius-lg);
    background: var(--color-mist-100);
  }

  @media (max-width: 40rem) {
    .fai-stage {
      aspect-ratio: 4 / 3;
    }
  }

  .fai-stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 50%;
  }

  .fai-after {
    clip-path: inset(0 0 0 var(--cmp));
  }

  .fai-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--cmp);
    width: 2px;
    margin-left: -1px;
    background: var(--color-paper);
    pointer-events: none;
  }

  /* A paper tab on the cut line, the same tab as the tool sliders. */
  .fai-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 44px;
    translate: -50% -50%;
    border: 2px solid var(--color-paper);
    border-radius: 9px;
    background: var(--color-pine-800);
    box-shadow: 1px 2px 3px -1px rgb(15 29 25 / 0.35);
  }

  .fai-labels {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 clamp(1rem, 2.5vw, 1.5rem) clamp(0.875rem, 2vw, 1.25rem);
    color: var(--color-paper);
    font-weight: 600;
    font-size: 0.9375rem;
    text-shadow: 0 1px 2px rgb(15 29 25 / 0.7), 0 0 12px rgb(15 29 25 / 0.45);
    pointer-events: none;
  }

  /* The whole photo is the drag target; the native input keeps keys and screen readers. */
  .fai-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .fai-stage:has(.fai-range:focus-visible) {
    outline: 3px solid var(--color-kesar-600);
    outline-offset: 3px;
  }

  .fai-tools {
    display: grid;
    gap: 1.75rem 2.5rem;
  }

  @media (min-width: 48rem) {
    .fai-tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Name, note and link sit on shared rows across the three columns. */
  .fai-tools li {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.375rem;
    align-content: start;
  }

  @supports (grid-template-rows: subgrid) {
    @media (min-width: 48rem) {
      .fai-tools {
        grid-template-rows: auto 1fr auto;
      }

      .fai-tools li {
        grid-row: span 3;
        grid-template-rows: subgrid;
      }
    }
  }

  .fai-name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.2;
  }

  .fai-note {
    max-width: 34ch;
    color: var(--color-ink-800);
  }

  .fai-go {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.375rem;
    min-height: 44px;
    margin-top: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--color-kesar-700);
    cursor: pointer;
    transition: color 160ms ease;
  }

  .fai-go:hover {
    color: var(--color-kesar-800);
  }

  .fai-go :global(.arrow) {
    transition: translate 160ms ease;
  }

  .fai-go:hover :global(.arrow) {
    translate: 2px -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .fai-go,
    .fai-go :global(.arrow) {
      transition: none;
    }
  }
</style>
