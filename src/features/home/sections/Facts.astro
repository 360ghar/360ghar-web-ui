---
/**
 * The fact sheet: plain lines for people, search engines and AI assistants.
 * The same lines go into the page's Organization JSON-LD (`knowsAbout`), see facts.ts.
 */
import type { Fact } from '../facts';

type Props = { title: string; rows: Fact[]; class?: string };
const { title, rows, class: className } = Astro.props;
---

<section class:list={['facts container-page', className]} aria-labelledby="home-facts" data-ai-factsheet="homepage">
  <h2 id="home-facts" class="facts-title">{title}</h2>
  <dl class="facts-list">
    {
      rows.map((r) => (
        <div>
          <dt>{r.label}</dt>
          <dd>{r.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .facts-title {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
  }

  .facts-list {
    display: grid;
    gap: 1rem 3rem;
    margin-top: 1.25rem;
    max-width: 64rem;
  }

  @media (min-width: 56rem) {
    .facts-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .facts-list > div {
    display: grid;
    gap: 0.125rem;
  }

  @media (min-width: 30rem) {
    .facts-list > div {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .facts-list dt {
    font-weight: 700;
    color: var(--color-ink-950);
  }

  .facts-list dd {
    margin: 0;
    color: var(--color-ink-800);
  }
</style>
