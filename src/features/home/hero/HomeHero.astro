---
/**
 * The home hero: the Golden Hour paper street filling the first screen, with
 * the search sheet resting on it.
 *
 * The art is anchored to the bottom and the layers keep the diorama's own
 * sizing, so the scene covers the whole first screen. On a tall screen
 * `preserveAspectRatio="xMidYMax slice"` crops the sides and shows the middle
 * third, which is the part the scene is drawn for.
 */
import Diorama from '@/features/home/diorama/Diorama.astro';
import { COPY } from '@/features/home/copy';
import HeroSearch from '@/features/search/HeroSearch';
import { cutBandPath } from '@/lib/paper/cut';
import { getT } from '@/i18n';
import type { Locale } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = getT(locale);
const c = COPY[locale];

// The fold. The scene is clipped by the hero's box, so the street would end on a
// ruler-straight line against the page. This strip is a hand-cut paper edge in
// the street's own colour, the same idiom as `CutBand`, so the hero meets the
// page below the way the other bands do.
const fold = cutBandPath('home-hero-fold', 1440, 22, 44);
---

<section class="home-hero" aria-labelledby="home-title">
  <Diorama class="home-diorama" label={c.diorama} />
  {/* The filter lives on this HTML wrapper: on an SVG root the CSS filter is
      clipped to the element's filter region, which cuts the shadow off. */}
  <div class="home-hero-edge" aria-hidden="true">
    <svg viewBox="0 0 1440 22" preserveAspectRatio="none" focusable="false">
      {/* The helper cuts its wavy edge at the top. Flipping it here, inside the
          SVG, puts the cut at the bottom and keeps the shadow pointing down: a
          transform on the element would flip the shadow too. */}
      <g transform="translate(0 22) scale(1 -1)">
        <path d={fold} fill="var(--color-dio-street)" />
      </g>
    </svg>
  </div>
  <div class="container-page home-hero-stack">
    {/* The headline fills the empty sky on the left; the search stays on the
        street below. The lead inherits the stack's pointer-events: none, so the
        diorama still receives pointer movement. */}
    <div class="home-hero-lead">
      <p class="home-hero-eyebrow">
        <Icon name="pin" size={16} />
        {t('site:home.eyebrow')}
      </p>
      <h1 id="home-title" class="home-hero-title">{t('site:home.title')}</h1>
    </div>
    <div class="home-search-lift">
      <div class="home-search-sheet">
        <HeroSearch client:load locale={locale} postLink="none" />
      </div>
    </div>
  </div>
</section>

<style>
  /* The whole first screen, header strip included (the header paints the same
     sky over it and is 64 px tall). */
  .home-hero {
    position: relative;
    display: grid;
    min-height: max(34rem, calc(100svh - 64px));
    isolation: isolate;
  }

  .home-hero :global(.home-diorama) {
    grid-area: 1 / 1;
    align-self: stretch;
  }

  /*
   * The cut edge at the fold, drawn in the street's own colour so the join
   * disappears. The path is flipped inside the SVG, so the cut faces the page
   * below and the straight edge butts up under the street. The box starts 6px
   * above the fold and runs 16px past it: the cut's highest point lands 0.5px
   * above the fold, under the street, and its lowest hangs 10px onto the page.
   * No white sliver can open between the street and its edge, and the shadow
   * falls on the page as the soft shift to the next section.
   */
  .home-hero-edge {
    grid-area: 1 / 1;
    align-self: end;
    z-index: 5;
    width: 100%;
    height: 22px;
    margin-bottom: -16px;
    pointer-events: none;
    filter: drop-shadow(0 5px 7px rgb(var(--tint) / 0.3));
  }

  .home-hero-edge svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-hero-stack {
    grid-area: 1 / 1;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding-block: clamp(2rem, 6vh, 4rem) clamp(2rem, 8vh, 5rem);
    /* The stack lies over the whole scene, so it must not swallow the pointer:
       the layers ease toward the cursor. Only the sheet is a real surface. */
    pointer-events: none;
  }

  .home-hero-lead {
    max-width: 46rem;
  }

  .home-hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-ink-600);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .home-hero-eyebrow:lang(hi) {
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .home-hero-title {
    max-width: 16ch;
    color: var(--color-ink-950);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.4rem + 4.2vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .home-hero-title:lang(hi) {
    line-height: 1.25;
  }

  .home-search-lift {
    max-width: 56rem;
    margin-inline: auto;
    width: 100%;
  }

  .home-search-sheet {
    pointer-events: auto;
    padding: 1rem;
    background: var(--color-paper);
    border-radius: var(--radius-xl);
    box-shadow: 0 2px 2px rgb(var(--tint) / 0.06), 0 18px 32px -14px rgb(var(--tint) / 0.24);
  }

  @media (min-width: 48rem) {
    .home-search-sheet {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
