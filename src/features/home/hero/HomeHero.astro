---
/**
 * The home hero: the paper street filling the first screen, with the search
 * sheet resting on it.
 *
 * The art is anchored to the bottom and the layers keep the diorama's own
 * sizing, so the scene covers the whole first screen. On a tall screen
 * `preserveAspectRatio="xMidYMax slice"` crops the sides and shows the middle
 * third, which is the part the scene is drawn for.
 *
 * `variant` picks the artwork, not the palette: the same paper street, framed
 * three ways. Layout is the same for all of them.
 */
import Diorama from '@/features/home/diorama/Diorama.astro';
import { COPY } from '@/features/home/copy';
import type { HomeData } from '@/features/home/load';
import HeroSearch from '@/features/search/HeroSearch';
import { getT } from '@/i18n';
import type { Locale } from '@/lib/i18n/locale';

export type HeroArt = 'street' | 'skyline' | 'homes';

type Props = { locale: Locale; data: HomeData; variant?: HeroArt };
const { locale, variant = 'street' } = Astro.props;
const t = getT(locale);
const c = COPY[locale];

/**
 * The three studies, far to near:
 * `street` is the whole scene. `skyline` climbs to the towers and drops the
 * ground, so the frame is all glass and sky. `homes` comes down to street level
 * and drops the towers and the metro, so the apartment blocks, the chai stall,
 * the auto and the cow carry the frame.
 *
 * `skyline` also drops the kite. The string is a long diagonal from the kite to
 * a roof, so at any width where the kite itself is off frame the string alone
 * crosses the edge as a line to nowhere. Without it the study reads as a clean
 * skyline, and the kite stays where it belongs, in the two street scenes.
 *
 * The frames keep the artwork reaching both edges of the frame, so no study
 * leaves a dead band of sky where the scene stopped. `skyline` starts at y 160,
 * just above the tallest tower, and stays at x 0 so the towers run off both
 * sides. The sun is whole above 1024px and cropped by the viewport edge below
 * that, which is what a full-bleed scene does at any edge.
 */
const ART: Record<HeroArt, { omit: string[]; view: [number, number, number, number]; label: string }> = {
  street: { omit: [], view: [0, 0, 1600, 960], label: c.diorama },
  skyline: { omit: ['kite', 'blocks', 'metro', 'train', 'street', 'kerb'], view: [0, 160, 1600, 640], label: c.dioramaSkyline },
  homes: { omit: ['towers', 'kite', 'metro', 'train'], view: [0, 400, 1600, 560], label: c.dioramaHomes },
};
const art = ART[variant];
---

<section class="home-hero" data-hero={variant} aria-labelledby="home-title">
  <Diorama class="home-diorama" label={art.label} omit={art.omit} view={art.view} />
  <div class="container-page home-hero-stack">
    <div class="home-search-lift">
      <div class="home-search-sheet">
        {/* The page keeps one h1 for search engines and screen readers. The card
            itself is just the search now, and the owner CTA lives in its own band
            further down the page. */}
        <h1 id="home-title" class="visually-hidden">{t('site:home.title')}</h1>
        <HeroSearch client:load locale={locale} postLink="none" />
      </div>
    </div>
  </div>
</section>

<style>
  /* The whole first screen, header strip included (the header paints the same
     sky over it and is 64 px tall). */
  .home-hero {
    position: relative;
    display: grid;
    min-height: max(34rem, calc(100svh - 64px));
    isolation: isolate;
  }

  .home-hero :global(.home-diorama) {
    grid-area: 1 / 1;
    align-self: stretch;
    /* The road dissolves into the page at the fold instead of stopping on a
       hard horizontal line. Twenty-one stops on a smoothstep curve, so the
       fade eases: no pair of stops is steep enough to read as a band. */
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 1) 0%,
      rgb(0 0 0 / 1) 84%,
      rgb(0 0 0 / 0.9928) 84.8%,
      rgb(0 0 0 / 0.972) 85.6%,
      rgb(0 0 0 / 0.9393) 86.4%,
      rgb(0 0 0 / 0.896) 87.2%,
      rgb(0 0 0 / 0.8438) 88%,
      rgb(0 0 0 / 0.784) 88.8%,
      rgb(0 0 0 / 0.7183) 89.6%,
      rgb(0 0 0 / 0.648) 90.4%,
      rgb(0 0 0 / 0.5748) 91.2%,
      rgb(0 0 0 / 0.5) 92%,
      rgb(0 0 0 / 0.4253) 92.8%,
      rgb(0 0 0 / 0.352) 93.6%,
      rgb(0 0 0 / 0.2818) 94.4%,
      rgb(0 0 0 / 0.216) 95.2%,
      rgb(0 0 0 / 0.1563) 96%,
      rgb(0 0 0 / 0.104) 96.8%,
      rgb(0 0 0 / 0.0608) 97.6%,
      rgb(0 0 0 / 0.028) 98.4%,
      rgb(0 0 0 / 0.0073) 99.2%,
      transparent 100%
    );
  }

  .home-hero-stack {
    grid-area: 1 / 1;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: clamp(2rem, 6vh, 4rem) clamp(2rem, 8vh, 5rem);
    /* The stack lies over the whole scene, so it must not swallow the pointer:
       the layers ease toward the cursor. Only the sheet is a real surface. */
    pointer-events: none;
  }

  .home-search-lift {
    max-width: 56rem;
    margin-inline: auto;
    width: 100%;
  }

  .home-search-sheet {
    pointer-events: auto;
    padding: 1rem;
    background: var(--color-paper);
    border-radius: var(--radius-xl);
    box-shadow: 0 2px 2px rgb(var(--tint) / 0.06), 0 18px 32px -14px rgb(var(--tint) / 0.24);
  }

  @media (min-width: 48rem) {
    .home-search-sheet {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
