---
/**
 * /ai-agent lists the MCP tool definitions maintained in ./mcp.ts.
 * It does not confirm live server availability or property information.
 */
import { getT } from '@/i18n';
import Page from '@/layouts/Page.astro';
import { byLocale } from '@/lib/i18n/locale';
import Breadcrumbs from '@/ui/Breadcrumbs.astro';
import Paper from '@/ui/Paper.astro';
import CopyButton from '@/features/content/shared/CopyButton';
import { trail } from '@/features/content/shared/schema';
import { MCP_GROUPS, MCP_URL } from './mcp';
import TableScroll from '@/features/content/shared/TableScroll.astro';
import PageArt from '@/features/content/shared/PageArt.astro';

const locale = Astro.locals.locale;
const t = getT(locale);
const a = (k: string) => t(`policies:aiAgent.${k}`);
const hi = locale === 'hi';
const PATH = '/ai-agent';

const H = byLocale(locale, {
  en: {
    name: '360Ghar MCP tools',
    copy: 'Copy server URL',
    copied: 'Copied',
    tool: 'Tool name',
    does: 'Description',
    signIn: 'Sign-in requirement',
    yes: 'Required',
    no: 'Not marked as required',
    groups: { discovery: 'Search and discovery', visits: 'Visits', stays: 'Short-stay bookings', listings: 'Owners: listings', rentals: 'Owners: rent, leases and maintenance', tenant: 'Tenants', system: 'System' },
    limitations: 'This directory reflects the tool definitions and sign-in notes shown here. It does not confirm live availability or verify property information. Confirm important details with the relevant parties.',
  },
  hi: {
    name: '360Ghar MCP टूल',
    copy: 'सर्वर URL कॉपी करें',
    copied: 'कॉपी हो गया',
    tool: 'टूल',
    does: 'विवरण',
    signIn: 'साइन-इन आवश्यकता',
    yes: 'ज़रूरी',
    no: 'ज़रूरी होना सूची में नहीं दिखाया गया',
    groups: { discovery: 'खोज', visits: 'विज़िट', stays: 'शॉर्ट स्टे बुकिंग', listings: 'मालिक: लिस्टिंग', rentals: 'मालिक: किराया, लीज़ और मेंटेनेंस', tenant: 'किरायेदार', system: 'सिस्टम' },
    limitations: 'यह सूची यहाँ दिखाए गए टूल विवरण और साइन-इन नोट पर आधारित है। यह लाइव उपलब्धता या प्रॉपर्टी की जानकारी की पुष्टि नहीं करती। ज़रूरी विवरण संबंधित पक्षों से पुष्टि करें।',
  },
});

const { crumbs, ld } = trail(locale, [{ name: H.name, path: PATH }]);
---

<Page title={t('seo:aiAgent.title')} description={t('seo:aiAgent.description')} path={PATH} jsonLd={[ld]}>
  <div class="container-page agent">
    <Breadcrumbs items={crumbs} />
    <div class="agent-top">
      <header class="agent-head">
        <h1 class="agent-h1">{a('heroTitle')} {a('heroTitleGradient')}</h1>
        <p class="agent-lead">{a('heroDesc')}</p>
        <PageArt scene="chat" seed="ai-agent" />
      </header>

      <div class="agent-server">
        <Paper seed="mcp-server" tone="ink" depth={3} innerClass="agent-server-inner">
          <p class="agent-server-label">{a('mcpServerLabel')}</p>
          <p class="agent-server-url"><code>{MCP_URL}</code></p>
          <p class="agent-server-body">{a('mcpInfoText')}</p>
          <div class="agent-server-actions">
            <CopyButton client:load locale={locale} text={MCP_URL} label={H.copy} done={H.copied} primary />
          </div>
        </Paper>
      </div>
    </div>

    <section class="agent-block" aria-labelledby="agent-tools">
      <h2 id="agent-tools" class="agent-h2">{a('toolsAvailableTitle')}</h2>
      <p class="agent-sub">{a('mcpDesc')}</p>
      {
        MCP_GROUPS.map((g) => (
          <div class="agent-group">
            <h3>{H.groups[g.key]}</h3>
            <TableScroll label={H.groups[g.key]} class="agent-scroll">
              <table class="agent-table">
                <thead>
                  <tr>
                    <th scope="col">{H.tool}</th>
                    <th scope="col">{H.does}</th>
                    <th scope="col">{H.signIn}</th>
                  </tr>
                </thead>
                <tbody lang={hi ? 'en' : undefined}>
                  {g.tools.map((x) => (
                    <tr>
                      <th scope="row">
                        <code>{x.name}</code>
                      </th>
                      <td>{x.does}</td>
                      <td class:list={['agent-auth', x.open && 'is-open']} lang={locale}>
                        {x.open ? H.no : H.yes}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </TableScroll>
          </div>
        ))
      }
      <p class="agent-note">{H.limitations}</p>
    </section>
  </div>
</Page>

<style>
  .agent {
    padding-top: 0.5rem;
  }

  .agent-top {
    display: grid;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 64rem) {
    .agent-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      gap: 4rem;
      align-items: end;
    }
  }

  .agent-head {
    display: grid;
    gap: 0.75rem;
  }

  .agent-h1 {
    font-size: clamp(2.25rem, 1.3rem + 3.4vw, 4rem);
  }

  .agent-lead {
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--color-ink-800);
  }

  .agent-server {
    --tint: 0 0 0;
  }

  .agent-server :global(.agent-server-inner) {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .agent-server-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-kesar-200);
  }

  .agent-server-url {
    font-size: clamp(1.0625rem, 0.9rem + 0.8vw, 1.375rem);
    font-weight: 700;
    color: var(--color-paper);
    overflow-wrap: anywhere;
  }

  .agent-server-body {
    font-size: 0.9375rem;
    color: var(--color-kesar-100);
  }

  .agent-server-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.25rem;
  }

  .agent-block {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .agent-h2 {
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    max-width: 24ch;
  }

  .agent-sub {
    margin-top: 0.5rem;
    max-width: 60ch;
    color: var(--color-ink-800);
  }

  .agent-group {
    margin-top: 2rem;
  }

  .agent-group h3 {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 800;
  }

  .agent-group :global(.agent-scroll) {
    margin-top: 0.5rem;
  }

  .agent-table {
    width: 100%;
    max-width: 64rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .agent-table th,
  .agent-table td {
    padding: 0.625rem 0.75rem 0.625rem 0;
    border-bottom: 1px solid var(--color-ink-200);
    text-align: left;
    vertical-align: top;
  }

  .agent-table thead th {
    font-size: 0.8125rem;
    color: var(--color-ink-600);
  }

  .agent-table th[scope='row'] {
    width: 34%;
    font-weight: 400;
  }

  .agent-table code {
    font-size: 0.875rem;
    color: var(--color-kesar-900);
    overflow-wrap: anywhere;
  }

  .agent-table td {
    color: var(--color-ink-800);
  }

  .agent-auth {
    width: 8rem;
    white-space: nowrap;
  }

  .agent-auth.is-open {
    color: var(--color-leaf-700);
    font-weight: 700;
  }

  .agent-note {
    max-width: 72ch;
    margin-top: 2rem;
    color: var(--color-ink-700);
  }
</style>
