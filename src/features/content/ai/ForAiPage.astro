---
/** /for-ai lists selected discovery pages and project targets, not inventory coverage. */
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';
import { localizer, byLocale } from '@/lib/i18n/locale';
import { trail } from '@/features/content/shared/schema';
import { AI_PAGES } from './discovery';
import { MCP_URL } from './mcp';
import PageArt from '@/features/content/shared/PageArt.astro';

const locale = Astro.locals.locale;
const t = getT(locale);
const f = (key: string) => t(`policies:forAI.${key}`);
const hi = locale === 'hi';
const L = localizer(locale);
const path = '/for-ai';
const files = ['/llms.txt', '/llms-full.txt', '/data/llm-feed.json', '/.well-known/ai.txt'];

const H = byLocale(locale, {
  en: {
    name: 'For AI Assistants',
    targetMarkets: ['Gurugram', 'Delhi', 'Noida', 'Faridabad', 'Ghaziabad'],
  },
  hi: {
    name: 'AI सहायकों के लिए',
    targetMarkets: ['गुरुग्राम', 'दिल्ली', 'नोएडा', 'फरीदाबाद', 'गाज़ियाबाद'],
  },
});

const { crumbs, ld } = trail(locale, [{ name: H.name, path }]);
---

<Content
  title={t('seo:forAI.title')}
  description={t('seo:forAI.description')}
  path={path}
  heading={f('pageTitle')}
  lead={f('pageIntro')}
  crumbs={crumbs}
  jsonLd={[ld]}
>
  <PageArt slot="head" scene="chat" seed="for-ai" />

  <h2>{f('targetsTitle')}</h2>
  <p>{f('targetNote')}</p>
  <ul>
    {H.targetMarkets.map((market) => <li>{market}</li>)}
  </ul>

  <h2>{f('discoveryTitle')}</h2>
  <ul lang={hi ? 'en' : undefined}>
    {/* The /hi entries are for llms.txt; each one is a page this list already links in the visitor's locale. */}
    {AI_PAGES.filter(([, target]) => target !== '/hi' && !target.startsWith('/hi/')).map(([name, target]) => <li><a href={L(target)}>{name}</a></li>)}
  </ul>

  <h2>{f('filesTitle')}</h2>
  <ul>
    {files.map((file) => <li><a href={file}>{file}</a></li>)}
  </ul>

  <h2>{f('mcpTitle')}</h2>
  <p>{f('mcpText')}</p>
  <p><code>{MCP_URL}</code></p>
  <p><a href={L('/ai-agent')}>{f('toolLink')}</a></p>

  <h2>{f('evidenceTitle')}</h2>
  <p>{f('evidenceText')}</p>
</Content>
