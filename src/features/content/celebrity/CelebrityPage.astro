---
/** /celebrity-homes (SSG). A name links to its blog post only if GET /blog/posts/{slug} found it at build time. */
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';
import { localizer, byLocale } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';
import { trail } from '@/features/content/shared/schema';
import { CELEBRITY_CITIES, celebrityCards } from './data';
import { publishedCelebritySlugs } from './load';
import PageArt from '@/features/content/shared/PageArt.astro';

const locale = Astro.locals.locale;
const t = getT(locale);
const hi = locale === 'hi';
const L = localizer(locale);
const PATH = '/celebrity-homes';
const cards = celebrityCards(await publishedCelebritySlugs());

const H = byLocale(locale, {
  en: {
    name: 'Celebrity Homes',
    h1: 'Celebrity Homes in India (2026)',
    lead: "Where India's film and sports stars live: the city, the kind of home, and what it says about the area.",
    pending: 'Our full case studies on these homes are not published yet. When one is, its name links to it.',
    read: 'Read the case study',
  },
  hi: {
    name: 'सेलिब्रिटी घर',
    h1: 'भारत में सेलिब्रिटी घर (2026)',
    lead: 'भारत के फ़िल्म और खेल सितारे कहाँ रहते हैं: शहर, घर का प्रकार, और उस इलाके के बारे में यह क्या बताता है।',
    pending: 'इन घरों पर हमारी पूरी केस स्टडी अभी प्रकाशित नहीं हुई हैं। प्रकाशित होने पर नाम पर क्लिक करके पढ़ सकेंगे।',
    read: 'केस स्टडी पढ़ें',
  },
});

const { crumbs, ld } = trail(locale, [{ name: H.name, path: PATH }]);
---

<Content title={t('seo:celebrityHomes.title')} description={t('seo:celebrityHomes.description')} path={PATH} heading={H.h1} lead={H.lead} crumbs={crumbs} wide jsonLd={[ld]} newsletter>
  <PageArt slot="head" scene="bungalow" />
  {cards.some((c) => !c.post) && <p class="celeb-note">{H.pending}</p>}

  <ul class="celeb-list" role="list" lang={hi ? 'en' : undefined}>
    {
      cards.map((c) => (
        <li>
          {c.post ? (
            <a class="celeb-name is-link" href={L(c.post)}>
              {c.name}
              <Icon name="arrow-up-right" size={22} class="arrow" label={H.read} />
            </a>
          ) : (
            <p class="celeb-name">{c.name}</p>
          )}
          <p class="celeb-where">
            <Icon name="pin" size={16} />
            {c.location}
          </p>
          <p class="celeb-what">
            <strong>{c.type}.</strong> {c.highlights}.
          </p>
        </li>
      ))
    }
  </ul>

  <div class="celeb-more" lang={hi ? 'en' : undefined}>
    <section>
      <h2>Why celebrity homes matter for real estate</h2>
      <p>
        Celebrity property purchases signal neighbourhood desirability. When stars buy in an area, infrastructure, security and amenities often follow, which can lift values for the properties around them. The case studies look at the real estate logic behind each purchase, not only the homes.
      </p>
    </section>
    <section>
      <h2>Top celebrity real estate localities in India</h2>
      <div class="celeb-cities">
        {
          CELEBRITY_CITIES.map((c) => (
            <div>
              <h3>{c.city}</h3>
              <ul>
                {c.places.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Content>

<style>
  .celeb-note {
    max-width: 60ch;
    margin-bottom: 1.5rem;
    color: var(--color-ink-800);
  }

  /* A typographic index of names, not a grid of cards. */
  ul.celeb-list {
    display: grid;
    gap: 0 3rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    ul.celeb-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .celeb-list > li {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    max-width: none;
    margin: 0;
    padding: 1.125rem 0 1.25rem;
    border-top: 1px solid var(--color-ink-200);
  }

  .celeb-list .celeb-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.05;
    color: var(--color-ink-950);
  }

  .celeb-list a.celeb-name {
    text-decoration: none;
  }

  .celeb-list a.celeb-name:hover {
    color: var(--color-kesar-700);
  }

  .celeb-list .celeb-where {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 700;
    color: var(--color-kesar-700);
  }

  .celeb-list .celeb-what {
    color: var(--color-ink-800);
  }

  .celeb-more {
    display: grid;
    gap: 0 3rem;
    max-width: 72rem;
  }

  @media (min-width: 64rem) {
    .celeb-more {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
  }

  .celeb-cities {
    display: grid;
    gap: 0 2rem;
  }

  @media (min-width: 40rem) {
    .celeb-cities {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .celeb-cities h3 {
    margin-top: 1rem;
  }
</style>
