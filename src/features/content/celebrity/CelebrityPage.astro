---
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';

const locale = Astro.locals.locale;
const hi = locale === 'hi';
const t = getT(locale);
const path = '/celebrity-homes';
const title = t('seo:celebrityHomes.title');
const description = t('seo:celebrityHomes.description');
const heading = hi ? 'सेलिब्रिटी घरों की जानकारी समीक्षा के अधीन' : 'Celebrity home details under review';
const notice = hi
  ? 'स्रोतों, सटीकता और प्रकाशन अधिकारों की जाँच तक निवास स्थान, प्रॉपर्टी विवरण और लोकैलिटी से जुड़े दावे हटाए गए हैं।'
  : 'Residence locations, property details and locality claims are withheld while sources, accuracy and publication rights are reviewed.';
---

<Content title={title} description={description} path={path} noindex heading={heading} lead={notice}>
  <p>{notice}</p>
</Content>
