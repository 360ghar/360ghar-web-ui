---
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';
import { localizer } from '@/lib/i18n/locale';

const locale = Astro.locals.locale;
const hi = locale === 'hi';
const t = getT(locale);
const L = localizer(locale);
const path = '/list-property-free';
const title = t('seo:listPropertyFree.title');
const description = t('seo:listPropertyFree.description');
const heading = hi ? 'लिस्टिंग सेवा की जानकारी समीक्षा के अधीन' : 'Listing service information under review';
const notice = hi
  ? 'शुल्क, गोपनीयता और सेवाओं से जुड़े दावे समीक्षा तक रोके गए हैं। प्रॉपर्टी की जानकारी भेजने से पहले मौजूदा फ़ॉर्म और शर्तें देखें।'
  : 'Claims about fees, privacy and listing services are withheld while current terms and supporting evidence are reviewed. Check the current form and terms before submitting property details.';
---

<Content title={title} description={description} path={path} noindex heading={heading} lead={notice}>
  <a class="link" href={L('/post-property')}>
    {hi ? 'मौजूदा लिस्टिंग फ़ॉर्म देखें' : 'Review the current listing form'}
  </a>
</Content>
