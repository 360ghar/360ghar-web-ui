---
import Content from '@/layouts/Content.astro';
import { byLocale, localizer } from '@/lib/i18n/locale';

const locale = Astro.locals.locale;
const L = localizer(locale);
const path = '/gurugram-real-estate-guide';
const copy = byLocale(locale, {
  en: {
    title: 'Gurugram real estate guide under review | 360Ghar',
    description: 'Market prices, trends and service claims are withheld while their sources, evidence dates and reuse terms are reviewed.',
    heading: 'Gurugram market guide under review',
    notice: 'Price ranges, market trends and service claims from this guide are withheld until their sources and dates can be checked. This page does not provide investment, legal or tax advice.',
    browse: 'Browse property listings',
  },
  hi: {
    title: 'गुरुग्राम रियल एस्टेट गाइड समीक्षा के अधीन | 360Ghar',
    description: 'स्रोत, साक्ष्य की तारीख और उपयोग की शर्तों की समीक्षा तक बाज़ार कीमतें, रुझान और सेवा संबंधी दावे रोके गए हैं।',
    heading: 'गुरुग्राम बाज़ार गाइड की समीक्षा जारी',
    notice: 'इस गाइड की कीमतें, बाज़ार रुझान और सेवा संबंधी दावे तब तक रोके गए हैं, जब तक उनके स्रोत और तारीख जाँचे न जाएँ। यह पेज निवेश, क़ानूनी या टैक्स सलाह नहीं देता।',
    browse: 'प्रॉपर्टी लिस्टिंग देखें',
  },
});
---

<Content title={copy.title} description={copy.description} path={path} noindex heading={copy.heading} lead={copy.notice}>
  <a class="btn btn-primary" href={L('/properties')}>{copy.browse}</a>
</Content>
