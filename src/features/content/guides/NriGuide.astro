---
import Content from '@/layouts/Content.astro';

const hi = Astro.locals.locale === 'hi';
const path = '/nri-property-guide';
const title = hi ? 'NRI प्रॉपर्टी गाइड समीक्षा के अधीन | 360Ghar' : 'NRI property guide under review | 360Ghar';
const description = hi
  ? 'यह गाइड आधिकारिक स्रोतों की समीक्षा तक उपलब्ध नहीं है।'
  : 'This guide is held while its official sources are reviewed.';
const heading = hi ? 'NRI प्रॉपर्टी गाइड समीक्षा के अधीन' : 'NRI property guide under review';
const notice = hi
  ? 'कर, कानूनी और धन-प्रेषण संबंधी मार्गदर्शन हटाया गया है। नवीनतम नियमों के लिए आधिकारिक स्रोत देखें। यह पृष्ठ कानूनी या कर सलाह नहीं है।'
  : 'Tax, legal and remittance guidance has been withheld pending review. Check current rules in official sources. This page is not legal or tax advice.';
---

<Content title={title} description={description} path={path} noindex heading={heading} lead={notice}>
  <h2>{hi ? 'आधिकारिक स्रोत' : 'Official sources'}</h2>
  <ul>
    <li><a href="https://www.rbi.org.in/Scripts/BS_FemaNotifications.aspx">{hi ? 'RBI FEMA अधिसूचनाएँ' : 'RBI FEMA notifications'}</a></li>
    <li><a href="https://www.incometax.gov.in/iec/foportal/">{hi ? 'आयकर विभाग' : 'Income Tax Department'}</a></li>
  </ul>
</Content>
