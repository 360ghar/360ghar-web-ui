---
/** /property-investment-gurugram. Copy from i18n `policies:propertyInvestment.*` (en + hi). */
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';
import { localizer } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';
import Paper from '@/ui/Paper.astro';
import { splitLabel, splitNumber } from '@/features/content/shared/label';
import { article, trail } from '@/features/content/shared/schema';
import TableScroll from '@/features/content/shared/TableScroll.astro';
import PageArt from '@/features/content/shared/PageArt.astro';

const locale = Astro.locals.locale;
const t = getT(locale);
const g = (k: string) => t(`policies:propertyInvestment.${k}`);
const L = localizer(locale);
const PATH = '/property-investment-gurugram';
const list = (keys: string[]) => keys.map((k) => splitLabel(g(k)));

const advantages = list(['advantageLocation', 'advantageEconomy', 'advantageInfra', 'advantageDemand', 'advantageLegal']);
const areas = ['dlf', 'sohna', 'sector', 'newGurugram'].map((k) => ({
  title: g(`${k}Title`),
  body: g(`${k}Desc`),
  roi: splitLabel(g(`${k}Roi`)),
  yield: splitLabel(g(`${k}Yield`)),
  risk: splitLabel(g(`${k}Risk`)),
}));
const cols = { roi: areas[0]!.roi.label, yield: areas[0]!.yield.label, risk: areas[0]!.risk.label };
const hi = locale === 'hi';
const strategies = [1, 2, 3, 4].map((n) => ({ ...splitNumber(g(`strategy${n}Title`)), body: g(`strategy${n}Desc`) }));
const estimate = hi
  ? 'ये 2024 के अनुमान हैं। यह रिटर्न का वादा नहीं है और 360Ghar का डेटा नहीं है।'
  : 'These are estimates from 2024. They are not a promise of returns and not 360Ghar data.';
const trends = list(['trendAffordable', 'trendColiving', 'trendVirtual', 'trendGreen', 'trendSmart']);
const risks = list(['riskVolatility', 'riskLiquidity', 'riskRegulatory', 'riskLocation', 'riskEconomic']);
const steps = list(['step1', 'step2', 'step3', 'step4', 'step5']);

const { crumbs, ld } = trail(locale, [{ name: g('breadcrumbCurrent'), path: PATH }]);
const jsonLd = [ld, article({ headline: g('seoTitle'), description: g('seoDescription'), path: PATH, locale, published: '2024-01-01' })];
---

<Content
  title={g('seoTitle')}
  description={g('seoDescription')}
  keywords={g('seoKeywords')}
  path={PATH}
  type="article"
  article={{ published: '2024-01-01', section: 'Guides' }}
  heading={g('pageTitle')}
  lead={g('pageDesc')}
  crumbs={crumbs}
  jsonLd={jsonLd}
  newsletter
>
  <PageArt slot="head" scene="coin" seed="investment-guide" />
  <h2>{g('whyInvest')}</h2>
  <p>{g('whyInvestDesc')}</p>
  <h3>{g('keyAdvantages').replace(/:$/, '')}</h3>
  <ul>{advantages.map((a) => <li>{a.label && <strong>{a.label}: </strong>}{a.text}</li>)}</ul>

  <h2>{g('bestAreas')}</h2>
  <TableScroll label={g('bestAreas')}>
    <table class="pi-areas">
      <thead>
        <tr>
          <th scope="col">{t('policies:gurugramGuide.thLocation')}</th>
          <th scope="col">{cols.roi}</th>
          <th scope="col">{cols.yield}</th>
          <th scope="col">{cols.risk}</th>
        </tr>
      </thead>
      <tbody>
        {
          areas.map((a) => (
            <tr>
              <th scope="row">
                <span class="pi-area">{a.title}</span>
                <span class="pi-area-body">{a.body}</span>
              </th>
              <td class="tabular">{a.roi.text}</td>
              <td class="tabular">{a.yield.text}</td>
              <td>{a.risk.text}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </TableScroll>
  <p class="pi-note">
    {estimate}{' '}
    <a href={L('/rera-projects')}>{hi ? 'RERA प्रोजेक्ट देखें' : 'Check RERA projects'}</a>
  </p>

  <h2>{g('strategies')}</h2>
  <ol class="pi-strategies" role="list">
    {
      strategies.map((s) => (
        <li>
          <span class="pi-n" aria-hidden="true">{s.n}</span>
          <h3>{s.text}</h3>
          <p>{s.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="pi-two">
    <section>
      <h2>{g('marketTrends')}</h2>
      <ul>{trends.map((a) => <li>{a.label && <strong>{a.label}: </strong>}{a.text}</li>)}</ul>
    </section>
    <section>
      <h2>{g('riskFactors')}</h2>
      <ul>{risks.map((a) => <li>{a.label && <strong>{a.label}: </strong>}{a.text}</li>)}</ul>
    </section>
  </div>

  <h2>{g('howToStart')}</h2>
  <ol>{steps.map((a) => <li>{a.label && <strong>{a.label}: </strong>}{a.text}</li>)}</ol>

  <div class="pi-tip">
    <Paper seed="pi-tip" tone="mist-100" depth={2} innerClass="pi-tip-inner" as="aside">
      <p class="pi-tip-title">{g('proTipTitle').replace(/:$/, '')}</p>
      <p>{g('proTipDesc')}</p>
    </Paper>
  </div>

  <div class="page-actions">
    <a class="btn btn-primary btn-lg" href={L('/properties')}>
      {g('exploreProperties')}
      <Icon name="arrow-up-right" size={18} class="arrow" />
    </a>
    <a class="link" href={L('/gurugram-real-estate-guide')}>{g('readGuide')}</a>
  </div>
</Content>

<style>
  .pi-note {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .pi-areas th[scope='row'] {
    min-width: 14rem;
    background: transparent;
    font-weight: 400;
  }

  .pi-area {
    display: block;
    font-weight: 800;
  }

  .pi-area-body {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }

  .pi-areas td {
    white-space: nowrap;
  }

  ol.pi-strategies {
    display: grid;
    gap: 1.5rem 2.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
  }

  @media (min-width: 48rem) {
    ol.pi-strategies {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pi-strategies > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-content: start;
    margin: 0;
    max-width: none;
  }

  .pi-n {
    grid-row: span 2;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3rem;
    line-height: 0.9;
    color: var(--color-kesar-600);
  }

  .pi-strategies > li h3 {
    margin: 0;
  }

  .pi-two {
    display: grid;
    gap: 0 2.5rem;
  }

  @media (min-width: 48rem) {
    .pi-two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pi-tip {
    margin-top: 2.5rem;
  }

  .pi-tip :global(.pi-tip-inner) {
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .pi-tip .pi-tip-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--color-ink-950);
  }

  .pi-tip .pi-tip-title + p {
    margin-top: 0.375rem;
    color: var(--color-ink-950);
  }
</style>
