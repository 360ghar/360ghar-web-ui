---
import Content from '@/layouts/Content.astro';

const hi = Astro.locals.locale === 'hi';
const path = '/property-investment-gurugram';
const title = hi ? 'गुरुग्राम निवेश रिसर्च समीक्षा के अधीन | 360Ghar' : 'Gurugram investment research under review | 360Ghar';
const description = hi
  ? 'गुरुग्राम प्रॉपर्टी निवेश रिसर्च स्रोतों और तरीकों की समीक्षा तक रोकी गई है।'
  : 'Gurugram property investment research is held while its sources and methods are reviewed.';
const heading = hi ? 'निवेश रिसर्च समीक्षा के अधीन' : 'Investment research under review';
const notice = hi
  ? 'प्रकाशित रिसर्च में स्रोत की तारीखें और दोहराए जा सकने वाले तरीके शामिल होने तक आंकड़े रोके गए हैं।'
  : 'Figures are withheld until the research has dated source samples and reproducible methods.';
---

<Content title={title} description={description} path={path} noindex heading={heading} lead={notice} />
