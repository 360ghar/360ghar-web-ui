---
/**
 * Sourced, category-scoped comparison profile. Unknown means evidence is not
 * recorded; it does not mean a feature is unavailable.
 */
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';
import type { Locale } from '@/lib/i18n/locale';
import { localizer } from '@/lib/i18n/locale';
import { EVIDENCE_REVIEWED_ON, type Competitor, type EvidenceState } from './competitors';
import { trail, webPage } from '@/features/content/shared/schema';
import Icon from '@/ui/icons/Icon.astro';
import Paper from '@/ui/Paper.astro';
import TableScroll from '@/features/content/shared/TableScroll.astro';
import PageArt from '@/features/content/shared/PageArt.astro';

type Props = { locale: Locale; c: Competitor };
const { locale, c } = Astro.props;
const t = getT(locale);
const k = (key: string) => t(`compare:${key}`);
const hi = locale === 'hi';
const L = localizer(locale);
const path = `/vs/${c.slug}`;
const headingPrefix =
  c.category === 'property-marketplace'
    ? k('comparison.headingPrefix')
    : c.category === 'managed-accommodation'
      ? k('comparison.managedProfileHeadingPrefix')
      : k('comparison.unknownProfileHeadingPrefix');
const heading = `${headingPrefix} ${c.name}`;
const title = k(`${c.key}.pageTitle`);
const description = k(`${c.key}.pageDescription`);

const H = {
  lead: k('comparison.lead'),
  profile: k('comparison.profile'),
  category: k('comparison.category'),
  currentStatus: k('comparison.currentStatus'),
  source: k('comparison.source'),
  checkedOn: k('comparison.checkedOn'),
  implementation: `${k('comparison.implementation')} ${EVIDENCE_REVIEWED_ON}.`,
  evidence: k('comparison.evidence'),
  feature: k('comparison.feature'),
  ours: k('comparison.ours'),
  unknownNotice: k('comparison.unknownNotice'),
  seeProfiles: k('comparison.seeProfiles'),
  searchHomes: k('comparison.searchHomes'),
};

const { crumbs, ld } = trail(locale, [
  { name: k('breadcrumb.compare'), path: '/vs' },
  { name: heading, path },
]);
const jsonLd = [ld, webPage({ name: title, description, path, locale })];
const stateLabel = (state: EvidenceState) => k(`states.${state}`);
const categoryLabel = k(`categories.${c.category}`);
const currentStatusLabel = k(`currentStatus.${c.currentStatus}`);
---

<Content
  title={title}
  description={description}
  path={path}
  noindex={c.noindex}
  heading={heading}
  lead={H.lead}
  crumbs={crumbs}
  jsonLd={jsonLd}
  newsletter
>
  <PageArt slot="head" scene="scale" seed={c.slug} />
  <div class="vs-glance">
    <Paper seed={`profile-${c.slug}`} tone="mist-50" depth={2} innerClass="vs-glance-inner" as="section">
      <h2 class="vs-glance-title">{c.name}</h2>
      <dl class="vs-glance-dl" lang={hi ? 'en' : undefined}>
        <div>
          <dt lang={locale}>{H.category}</dt>
          <dd lang={locale}>{categoryLabel}</dd>
        </div>
        <div>
          <dt lang={locale}>{H.currentStatus}</dt>
          <dd lang={locale}>{currentStatusLabel}</dd>
        </div>
        <div class="vs-scope">
          <dt lang={locale}>{H.profile}</dt>
          <dd>{c.comparisonScope}</dd>
        </div>
      </dl>
      <p class="vs-company-description" lang={hi ? 'en' : undefined}>{c.companyDescription}</p>
      <p class="vs-source">
        <span>{H.source}: </span>
        <a href={c.source.url} rel="noopener noreferrer" lang={hi ? 'en' : undefined}>{c.source.label}</a>
        <span> · {H.checkedOn}: {c.source.checkedOn}</span>
      </p>
    </Paper>
  </div>

  <h2>{H.evidence}</h2>
  <p>{H.implementation} {H.unknownNotice}</p>
  <TableScroll label={H.evidence}>
    <table class="vs-features">
      <thead>
        <tr>
          <th scope="col">{H.feature}</th>
          <th scope="col">{H.ours}</th>
          <th scope="col">{c.name}</th>
        </tr>
      </thead>
      <tbody>
        {
          c.features.map((feature) => (
            <tr>
              <th scope="row" lang={hi ? 'en' : undefined}>{feature.feature}</th>
              <td>
                <span class:list={['vs-state', `vs-state-${feature.ourState}`]} lang={locale}>
                  {stateLabel(feature.ourState)}
                </span>
                <span class="vs-note" lang={hi ? 'en' : undefined}>{feature.ourNote}</span>
              </td>
              <td>
                <span class:list={['vs-state', `vs-state-${feature.competitorState}`]} lang={locale}>
                  {stateLabel(feature.competitorState)}
                </span>
                <span class="vs-note" lang={hi ? 'en' : undefined}>{feature.competitorNote}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </TableScroll>

  <p class="vs-actions">
    <a class="link" href={L('/vs')}>
      {H.seeProfiles}
      <Icon name="arrow-up-right" size={16} class="arrow" />
    </a>
    <a class="btn btn-primary" href={L('/properties')}>{H.searchHomes}</a>
  </p>
</Content>

<style>
  .vs-glance :global(.vs-glance-inner) {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .vs-glance .vs-glance-title {
    margin: 0;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
  }

  .vs-glance-dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    width: 100%;
  }

  @media (min-width: 48rem) {
    .vs-glance-dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .vs-glance-dl dt {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink-600);
  }

  .vs-glance-dl dd {
    margin-top: 0.125rem;
    font-weight: 800;
    color: var(--color-ink-950);
  }

  .vs-scope {
    grid-column: 1 / -1;
  }

  .vs-company-description,
  .vs-source {
    margin: 0;
    color: var(--color-ink-800);
  }

  .vs-source {
    font-size: 0.875rem;
  }

  .vs-features th[scope='row'] {
    width: 28%;
    background: transparent;
  }

  .vs-features td {
    width: 36%;
  }

  .vs-features th,
  .vs-features td {
    padding-inline: 0.5rem;
    overflow-wrap: anywhere;
  }

  .vs-state {
    display: inline-block;
    font-weight: 800;
  }

  .vs-state-available {
    color: var(--color-leaf-700);
  }

  .vs-state-limited {
    color: var(--color-haldi-700);
  }

  .vs-state-unavailable {
    color: var(--color-chili-700);
  }

  .vs-state-unknown {
    color: var(--color-ink-600);
  }

  .vs-note {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }

  .vs-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
