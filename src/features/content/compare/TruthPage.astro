---
/** Retained legacy evidence-note route. These pages are not indexed. */
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';
import type { Locale } from '@/lib/i18n/locale';
import { localizer } from '@/lib/i18n/locale';
import Icon from '@/ui/icons/Icon.astro';
import { trail } from '@/features/content/shared/schema';
import type { Competitor } from './competitors';
import type { TruthPage } from './truth';
import PageArt from '@/features/content/shared/PageArt.astro';

type Props = { locale: Locale; page: TruthPage; c: Competitor };
const { locale, page, c } = Astro.props;
const t = getT(locale);
const k = (key: string) => t(`compare:${key}`);
const L = localizer(locale);
const path = `/truth/${page.slug}`;
const profilePath = `/vs/${c.slug}`;
const title = `${k('truth.titlePrefix')} ${c.name}`;
const { crumbs, ld } = trail(locale, [
  { name: k('breadcrumb.compare'), path: '/vs' },
  { name: title, path },
]);

const description = k('truth.description');
---

<Content
  title={title}
  description={description}
  path={path}
  noindex
  heading={title}
  lead={k('truth.lead')}
  crumbs={crumbs}
  jsonLd={[ld]}
>
  <PageArt slot="head" scene="book" seed={page.slug} />
  <section aria-labelledby="truth-evidence">
    <h2 id="truth-evidence">{k('truth.evidence')}</h2>
    <p class="truth-description" lang={locale === 'hi' ? 'en' : undefined}>{c.companyDescription}</p>
    <p class="truth-source">
      <span>{k('truth.source')}: </span>
      <a href={page.source.url} rel="noopener noreferrer" lang={locale === 'hi' ? 'en' : undefined}>{page.source.label}</a>
      <span> · {k('truth.checkedOn')}: {page.checkedOn}</span>
    </p>
    <a class="link" href={L(profilePath)}>
      {k('truth.profile')} {c.name}
      <Icon name="arrow-up-right" size={16} class="arrow" />
    </a>
  </section>
</Content>

<style>
  .truth-description {
    color: var(--color-ink-800);
  }

  .truth-source {
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }
</style>
