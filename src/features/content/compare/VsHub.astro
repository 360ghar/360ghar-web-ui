---
import { getT } from '@/i18n';
import Content from '@/layouts/Content.astro';
import { localizer } from '@/lib/i18n/locale';
import { canonicalFor } from '@/lib/seo/site';
import { trail, webPage } from '@/features/content/shared/schema';
import { COMPETITORS } from './competitors';
import PageArt from '@/features/content/shared/PageArt.astro';

const locale = Astro.locals.locale;
const t = getT(locale);
const L = localizer(locale);
const PATH = '/vs';
const vs = t('compare:hero.vs');
const profiles = COMPETITORS.filter((competitor) => !competitor.noindex);

const k = (key: string) => t(`compare:${key}`);
const H = {
  title: k('hub.title'),
  description: k('hub.description'),
  h1: k('hub.h1'),
  lead: k('hub.lead'),
  profiles: k('hub.profiles'),
  profileWord: k('hub.profile'),
  serviceProfilePrefix: k('hub.serviceProfilePrefix'),
};
const categoryLabel = (category: string) => k(`categories.${category}`);

const { crumbs, ld } = trail(locale, [{ name: k('breadcrumb.compare'), path: PATH }]);
const jsonLd = [
  {
    ...webPage({ name: H.title, description: H.description, path: PATH, locale, type: 'CollectionPage' }),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: profiles.map((competitor, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${competitor.name} profile`,
        url: canonicalFor(`/vs/${competitor.slug}`, locale),
      })),
    },
  },
  ld,
];
---

<Content title={H.title} description={H.description} path={PATH} heading={H.h1} lead={H.lead} crumbs={crumbs} wide jsonLd={jsonLd}>
  <PageArt slot="head" scene="scale" />
  <section aria-labelledby="vs-compare">
    <h2 id="vs-compare">{H.profiles}</h2>
    <ul class="hub-vs" role="list">
      {
        profiles.map((competitor) => (
          <li>
            <a href={L(`/vs/${competitor.slug}`)}>
              <span class="hub-vs-word" aria-hidden="true">
                {competitor.category === 'property-marketplace' ? vs : H.profileWord}
              </span>
              <span class="hub-vs-name">
                <span class="visually-hidden">
                  {competitor.category === 'property-marketplace' ? `360Ghar ${vs} ` : H.serviceProfilePrefix}
                </span>
                {competitor.name}
              </span>
              <span class="hub-vs-tag">{categoryLabel(competitor.category)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Content>

<style>
  ul.hub-vs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .hub-vs > li {
    max-width: none;
    margin: 0;
  }

  .hub-vs a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 0 0.625rem;
    align-items: baseline;
    padding: 1rem 0 1.125rem;
    border-top: 1px solid var(--color-ink-200);
    color: var(--color-ink-950);
    font-weight: 400;
    text-decoration: none;
  }

  .hub-vs-word {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-kesar-700);
  }

  .hub-vs-name {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.25rem);
    font-weight: 800;
    line-height: 1.05;
    transition: color 140ms var(--ease-paper);
  }

  .hub-vs a:hover .hub-vs-name {
    color: var(--color-kesar-700);
  }

  .hub-vs-tag {
    grid-column: 2;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-600);
  }
</style>
