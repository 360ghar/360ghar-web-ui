---
/**
 * Head tags for SEO parity with the old site: title, description, canonical,
 * hreflang (en, hi, x-default), robots, Open Graph, Twitter and JSON-LD.
 * Rendered on the server, so crawlers see them without running JavaScript.
 * On noindex pages the canonical and hreflang tags are left out, as before.
 */
import { stripLocale } from '@/lib/i18n/locale';
import { absoluteUrl, canonicalFor, DEFAULT_OG_IMAGE, jsonLd, SITE_NAME, TWITTER } from './site';
import { siteBlocks, speakableWebPage } from './siteSchemas';

type Props = {
  title: string;
  description: string;
  /** English path for the canonical. Default: the current path without /hi. */
  path?: string;
  noindex?: boolean;
  image?: string | null;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  keywords?: string;
  jsonLd?: unknown[];
  /** Skip the site-wide blocks (Organization, WebSite, LocalBusiness, Person, MobileApplication) for tiny pages. */
  bare?: boolean;
  /** CSS selectors of the text a voice assistant may read (must match this page's markup). Adds a WebPage block with `speakable`. Off by default. */
  speakable?: string[];
  article?: { published?: string | null; modified?: string | null; section?: string | null; tags?: string[] };
  video?: string | null;
  prev?: string | null;
  next?: string | null;
  /** The LCP photo. Pass srcset and sizes when the img has them, so the preload matches the chosen file. */
  preloadImages?: (string | { src: string; srcset?: string; sizes?: string })[];
};

const {
  title,
  description,
  path,
  noindex = false,
  image,
  imageAlt = '360Ghar preview image',
  type = 'website',
  keywords,
  jsonLd: blocks = [],
  bare = false,
  speakable,
  article,
  video,
  prev,
  next,
  preloadImages = [],
} = Astro.props;

const locale = Astro.locals.locale;
const enPath = path ?? stripLocale(Astro.url.pathname);
const canonical = canonicalFor(enPath, locale);
const og = image ? absoluteUrl(image) : DEFAULT_OG_IMAGE;
const robots = noindex
  ? 'noindex,follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const withContext = (b: unknown) =>
  b && typeof b === 'object' && !Array.isArray(b) && !('@context' in (b as object))
    ? { '@context': 'https://schema.org', ...(b as object) }
    : b;

const site = bare ? [] : siteBlocks();
const voice = !bare && speakable?.length ? speakableWebPage(canonical, speakable) : null;
const all = [...site, voice, ...blocks].filter(Boolean).map(withContext);
---

<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="robots" content={robots} />
<meta name="googlebot" content={noindex ? 'noindex,follow' : 'index, follow'} />
{
  !noindex && (
    <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="en" href={canonicalFor(enPath, 'en')} />
      <link rel="alternate" hreflang="hi" href={canonicalFor(enPath, 'hi')} />
      <link rel="alternate" hreflang="x-default" href={canonicalFor(enPath, 'en')} />
    </>
  )
}
{prev && <link rel="prev" href={absoluteUrl(prev)} />}
{next && <link rel="next" href={absoluteUrl(next)} />}
{preloadImages.map((img) => (typeof img === 'string' ? { src: img } : img)).map((img) => <link rel="preload" as="image" href={img.src} imagesrcset={img.srcset} imagesizes={img.sizes} fetchpriority="high" />)}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={locale === 'hi' ? 'hi_IN' : 'en_IN'} />
<meta property="og:locale:alternate" content={locale === 'hi' ? 'en_IN' : 'hi_IN'} />
{video && <meta property="og:video" content={video} />}
{
  type === 'article' && article && (
    <>
      {article.published && <meta property="article:published_time" content={article.published} />}
      {article.modified && <meta property="article:modified_time" content={article.modified} />}
      {article.section && <meta property="article:section" content={article.section} />}
      {(article.tags ?? []).map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER} />
<meta name="twitter:creator" content={TWITTER} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={imageAlt} />

{all.map((b) => <script type="application/ld+json" set:html={jsonLd(b)} />)}
