# Static-asset response headers for Cloudflare Workers Assets. These rules apply
# ONLY to files served from the assets directory - Worker (SSR) responses ignore
# them, so SSR headers (security, Link on /, cache directives) live in
# src/middleware.ts and the endpoints. Ported from netlify.toml, which stays in
# the repo untouched until the production cutover.

# Applied to every static response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

# Hashed build assets are content-addressed.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Diorama layers: the HTML links them with ?v=<content hash>.
/diorama/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Old image URLs that search engines and links still use.
/assets/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Paper-cut drawings served as files (src/pages/art/** prerendered). No content
# hash on some, so one day. The on-demand /art/map/* endpoint sets its own headers.
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Prerendered HTML: short browser cache (the edge handles its own asset caching).
/*.html
  Cache-Control: public, max-age=60, stale-while-revalidate=604800

# The old PWA worker must never be cached, so its replacement can unregister it.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Discovery files: open CORS and a one-hour cache. The blocks below add only the Content-Type.
/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/.well-known/api-catalog
  Content-Type: application/linkset+json

/.well-known/openid-configuration
  Content-Type: application/json

/.well-known/oauth-authorization-server
  Content-Type: application/json

/.well-known/oauth-protected-resource
  Content-Type: application/json

/.well-known/mcp/server-card.json
  Content-Type: application/json

/.well-known/agent-skills/index.json
  Content-Type: application/json

/.well-known/agent-skills/*/SKILL.md
  Content-Type: text/markdown

/.well-known/acp.json
  Content-Type: application/json

/.well-known/ucp
  Content-Type: application/json

/.well-known/ai.txt
  Content-Type: text/plain

/openapi.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
