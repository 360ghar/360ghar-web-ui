# Public (sent to the browser)
# Local dev: /dev-api (Vite proxy). Deploy previews: empty (Netlify /api/v1 proxy). Production: unset (https://api.360ghar.com).
PUBLIC_API_BASE=/dev-api
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_GOOGLE_MAPS_API_KEY=
PUBLIC_GA_ID=G-0S1Q7466MM
# Server only
# Local backend (see 360ghar-backend README). Use https://api.360ghar.com only to read production data: the dev proxy forwards writes too.
API_ORIGIN=http://localhost:3600
# Set to true once the backend serves the owner AI routes (listing-draft, design-studio/stage, legal-draft). Shows the listing writer, staging and the two drafter tools.
PUBLIC_AI_OWNER_TOOLS=
